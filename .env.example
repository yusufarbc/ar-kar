# --------------------------------------------------------------------------
# Keystatic — GitHub storage modu (panel.ar-kar.com)
# --------------------------------------------------------------------------
# Bu 4 değer, Keystatic'in GitHub App üzerinden repoya commit atabilmesi için
# gereklidir. Yerelde .env dosyasına, canlıda Worker secret olarak girilir:
#
#   npx wrangler secret put KEYSTATIC_GITHUB_CLIENT_ID     --env production
#   npx wrangler secret put KEYSTATIC_GITHUB_CLIENT_SECRET --env production
#   npx wrangler secret put KEYSTATIC_SECRET               --env production
#
# PUBLIC_ önekli değer build sırasında gömülür; wrangler.jsonc > vars altına
# ya da CI ortam değişkeni olarak eklenmelidir.
#
# GitHub App'i oluşturmak için panele ilk girişte çıkan sihirbazı kullanın:
#   http://127.0.0.1:4321/keystatic  ->  "Get started with GitHub"

KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# --------------------------------------------------------------------------
# Cloudflare — scripts/setup-cloudflare.sh için
# --------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
