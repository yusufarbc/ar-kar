# Cloudflare Pages yönlendirmeleri (ana site)
#
# NOT: Eski .html adresleri (ör. /insaat.html) için kural yazmaya gerek yok —
# Cloudflare Pages bunları otomatik olarak uzantısız hâline (308) yönlendirir.
#
# Yönetim paneli ayrı bir Pages projesindedir (panel.ar-kar.com) ve
# Cloudflare Access ile korunur; bu sitede panel rotası yoktur.

# Hakkımızda ve İletişim artık kendi sayfaları (eskiden ana sayfa çıpasıydı).
# NOT: /#about gibi çıpalı adresler için kural yazılamaz — tarayıcı '#' sonrasını
# sunucuya hiç göndermez. Aşağıdakiler yalnızca gerçek yol takma adlarıdır.
/about                 /hakkimizda    301
/contact               /iletisim      301
/bize-ulasin           /iletisim      301
/kurumsal              /hakkimizda    301

# Kısa / alternatif yollar
/anasayfa              /              301
/home                  /              301
/projelerimiz          /projeler      301
/insaat-malzemeleri    /insaat        301
/pvc-pencere           /pvc           301
/zirai                 /ziraat        301
/tarim-urunleri        /tarim         301
/sikca-sorulan-sorular /sss           301

# Eski adres: içerik artık "blog" değil "haberler" olarak adlandırılıyor
# (bkz. src/pages/haberler/). Panelden yayınlanmış eski bağlantılar ve
# arama motorunda indekslenmiş adresler kırılmasın diye 301 ile taşınıyor.
/blog                  /haberler      301
/blog/*                /haberler/:splat 301

# Kaldırılan hizmetler (arama motorlarında indekslenmiş olabilir)
/otomotiv              /              301
/dekorasyon            /              301

# Panel kısayolu (ayrı Pages projesi)
/panel                 https://panel.ar-kar.com/   302
/admin                 https://panel.ar-kar.com/   302
