---
// Footer Component
import { COMPANY } from '../lib/company';
---

<!-- Footer Start -->
<div class="footer container-fluid position-relative bg-dark text-white-50 py-6 px-5">
    <div class="row g-5">
        <div class="col-lg-6 pe-lg-5">
            <a href="/" class="navbar-brand">
                <img src="/img/logo.webp" alt="AR-KAR İnşaat Logo" loading="lazy">
            </a>
            <p><i class="fa fa-map-marker-alt me-2" aria-hidden="true"></i>Çarşamba, Samsun</p>
            <p><i class="fa fa-phone me-2" aria-hidden="true"></i>0542 182 68 55</p>
            <p><i class="fa fa-envelope me-2" aria-hidden="true"></i>arkargida@gmail.com</p>
            <div class="d-flex justify-content-start mt-4">
                <a class="btn btn-lg btn-primary btn-lg-square rounded-0 me-2" href="mailto:arkargida@gmail.com" aria-label="E-posta gönder"><i
                        class="fa fa-envelope" aria-hidden="true"></i></a>
                <a class="btn btn-lg btn-primary btn-lg-square rounded-0 me-2"
                    href="https://wa.me/905421826855?text=" aria-label="WhatsApp'tan yazın"><i class="fab fa-whatsapp" aria-hidden="true"></i></a>
                <a class="btn btn-lg btn-primary btn-lg-square rounded-0 me-2"
                    href="https://www.facebook.com/arkarltd/" target="_blank" aria-label="Facebook'ta takip edin"><i class="fab fa-facebook-f" aria-hidden="true"></i></a>
                <a class="btn btn-lg btn-primary btn-lg-square rounded-0" href="https://www.instagram.com/arkarltd"
                    target="_blank" aria-label="Instagram'da takip edin"><i class="fab fa-instagram" aria-hidden="true"></i></a>
            </div>
        </div>
        <div class="col-lg-6 ps-lg-5">
            <div class="row g-5">
                <div class="col-sm-6">
                    <h4 class="text-white text-uppercase mb-4">Hızlı Linkler</h4>
                    <div class="d-flex flex-column justify-content-start">
                        <a class="text-white-50 mb-2" href="/"><i
                                class="fa fa-angle-right me-2" aria-hidden="true"></i>Anasayfa</a>
                        <a class="text-white-50 mb-2" href="/hakkimizda"><i
                                class="fa fa-angle-right me-2" aria-hidden="true"></i>Hakkımızda</a>
                        <a class="text-white-50 mb-2" href="/#projects"><i
                                class="fa fa-angle-right me-2" aria-hidden="true"></i>Projelerimiz</a>
                        <a class="text-white-50 mb-2" href="/blog"><i
                                class="fa fa-angle-right me-2" aria-hidden="true"></i>Haberler</a>
                        <a class="text-white-50 mb-2" href="/sss"><i
                                class="fa fa-angle-right me-2" aria-hidden="true"></i>Sık Sorulan Sorular</a>
                        <a class="text-white-50" href="/iletisim"><i
                                class="fa fa-angle-right me-2" aria-hidden="true"></i>İletişim</a>
                    </div>
                </div>
                <div class="col-sm-6">
                    <h4 class="text-white text-uppercase mb-4">Hizmetlerimiz</h4>
                    <div class="d-flex flex-column justify-content-start">
                        <a class="text-white-50 mb-2" href="/projeler"><i
                                class="fa fa-angle-right me-2" aria-hidden="true"></i>İnşaat Projeleri</a>
                        <a class="text-white-50 mb-2" href="/muteahhitlik"><i
                                class="fa fa-angle-right me-2" aria-hidden="true"></i>Anahtar Teslim İnşaat</a>
                        <a class="text-white-50 mb-2" href="/pvc"><i class="fa fa-angle-right me-2" aria-hidden="true"></i>PVC Kapı
                            Pencere</a>
                        <a class="text-white-50 mb-2" href="/tarim"><i class="fa fa-angle-right me-2" aria-hidden="true"></i>Tarım
                            Ürünleri</a>
                        <a class="text-white-50 mb-2" href="/ziraat"><i class="fa fa-angle-right me-2" aria-hidden="true"></i>Zirai
                            İlaç</a>
                        <a class="text-white-50 mb-2" href="/insaat"><i
                                class="fa fa-angle-right me-2" aria-hidden="true"></i>İnşaat Malzemeleri</a>
                        <a class="text-white-50 mb-2" href="/mimar"><i class="fa fa-angle-right me-2" aria-hidden="true"></i>Mimari
                            Proje</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Contact Modal Start -->
<div class="modal fade" id="contactModal" tabindex="-1" aria-labelledby="contactModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content contact-modal">
            <div class="modal-header contact-modal__header">
                <h5 class="modal-title" id="contactModalLabel">
                    <i class="fa fa-phone" aria-hidden="true"></i>AR-KAR İnşaat — Hızlı İletişim
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                    aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="contact-modal__grid">
                    {COMPANY.branches.map((branch) => (
                        <div class="contact-address-card">
                            <span class="contact-address-card__label">{branch.name}</span>
                            <p>{branch.street}<br>{branch.district}/{branch.city.toUpperCase()}</p>
                            <a href={branch.phoneHref}><i class="fa fa-phone" aria-hidden="true"></i>{branch.phone}</a>
                        </div>
                    ))}
                </div>

                <div class="contact-modal__quicklinks">
                    <a href={COMPANY.branches[0].phoneHref} class="contact-quick-link contact-quick-link--accent">
                        <i class="fa fa-phone" aria-hidden="true"></i><span>{COMPANY.branches[0].phone} — Ara</span>
                    </a>
                    <a href={`https://wa.me/${COMPANY.whatsapp}`} class="contact-quick-link contact-quick-link--accent" target="_blank">
                        <i class="fab fa-whatsapp" aria-hidden="true"></i><span>WhatsApp'tan Yazın</span>
                    </a>
                    <a href={`mailto:${COMPANY.email}`} class="contact-quick-link">
                        <i class="fa fa-envelope" aria-hidden="true"></i><span>E-posta Gönder</span>
                    </a>
                    <a href={COMPANY.facebook} class="contact-quick-link" target="_blank">
                        <i class="fab fa-facebook-f" aria-hidden="true"></i><span>Facebook'ta Takip Et</span>
                    </a>
                    <a href={COMPANY.instagram} class="contact-quick-link" target="_blank">
                        <i class="fab fa-instagram" aria-hidden="true"></i><span>Instagram'da Takip Et</span>
                    </a>
                </div>

                <div class="contact-modal__hours">
                    <i class="fa fa-clock" aria-hidden="true"></i>
                    <span><strong>{COMPANY.openingHours.days}:</strong> {COMPANY.openingHours.opens} – {COMPANY.openingHours.closes}</span>
                    <span class="contact-modal__hours-sep">·</span>
                    <span><strong>Pazar:</strong> Kapalı</span>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Contact Modal End -->

<style>
    .contact-modal { border: none; border-radius: var(--radius-lg, 20px); overflow: hidden; }
    .contact-modal__header {
        background: linear-gradient(135deg, var(--ink-900, #14151a) 0%, #23252c 100%);
        color: #fff;
        border: none;
        padding: 1.25rem 1.5rem;
    }
    .contact-modal__header .modal-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: var(--font-heading, inherit);
        font-weight: 700;
        /* design-system.css'teki genel 'h5 { color: var(--ink-900) }' kuralı
           element seçicisi olduğu için miras alınan #fff'i eziyordu — metin
           koyu zemin üzerinde neredeyse görünmez oluyordu. Doğrudan hedefle. */
        color: #fff;
    }
    .contact-modal__header .modal-title i { color: var(--primary, #E71E24); }

    .contact-modal__grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
        margin-bottom: 20px;
    }
    .contact-address-card {
        border: 1px solid var(--ink-100, #e7e8eb);
        border-radius: var(--radius-md, 14px);
        padding: 16px 18px;
    }
    .contact-address-card__label {
        display: inline-block;
        font-family: var(--font-heading, inherit);
        font-weight: 700;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--primary, #E71E24);
        margin-bottom: 8px;
    }
    .contact-address-card p { margin-bottom: 10px; font-size: 0.9rem; color: var(--ink-500, #5b5e68); }
    .contact-address-card a {
        display: inline-flex; align-items: center; gap: 6px;
        font-weight: 600; font-size: 0.88rem; color: var(--ink-900, #14151a); text-decoration: none;
    }
    .contact-address-card a i { color: var(--primary, #E71E24); }

    .contact-modal__quicklinks {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-bottom: 20px;
    }
    .contact-quick-link {
        display: flex; align-items: center; gap: 10px;
        padding: 12px 16px;
        border: 1px solid var(--ink-100, #e7e8eb);
        border-radius: var(--radius-md, 14px);
        font-weight: 600; font-size: 0.88rem;
        color: var(--ink-900, #14151a);
        text-decoration: none;
        transition: border-color 0.2s ease, transform 0.2s ease;
    }
    .contact-quick-link i { color: var(--primary, #E71E24); font-size: 1.05rem; width: 1.2em; text-align: center; }
    .contact-quick-link:hover { border-color: var(--primary, #E71E24); transform: translateY(-2px); color: var(--ink-900, #14151a); }
    .contact-quick-link--accent { background: var(--surface-alt, #f6f6f8); }

    .contact-modal__hours {
        display: flex; flex-wrap: wrap; align-items: center; gap: 8px;
        padding: 12px 16px;
        background: var(--surface-alt, #f6f6f8);
        border-radius: var(--radius-md, 14px);
        font-size: 0.85rem;
        color: var(--ink-500, #5b5e68);
    }
    .contact-modal__hours i { color: var(--primary, #E71E24); }
    .contact-modal__hours-sep { color: var(--ink-300, #9a9da6); }

    @media (max-width: 575.98px) {
        .contact-modal__grid,
        .contact-modal__quicklinks { grid-template-columns: 1fr; }
    }
</style>

<div class="container-fluid bg-dark text-white border-top border-primary px-0">
    <div class="d-flex flex-column flex-md-row justify-content-between">
        <div class="py-4 px-5 text-center text-md-start">
            <p>&copy; {new Date().getFullYear()} AR-KAR İnşaat. Tüm hakları saklıdır.</p>
        </div>
    </div>
</div>
<!-- Footer End -->

<!-- WhatsApp Floating Button -->
<div class="whatsapp-float">
    <a href={`https://wa.me/${COMPANY.whatsapp}?text=Merhaba, AR-KAR İnşaat hakkında bilgi almak istiyorum.`} target="_blank"
        rel="noopener" aria-label="WhatsApp İletişim">
        <i class="fab fa-whatsapp" aria-hidden="true"></i>
    </a>
</div>

<style>
    /* Marka rengiyle statik — eskiden jenerik yeşil (#25d366) + sürekli
       "pulse" animasyonuydu; bento CTA ve iletişim modalı zaten
       WhatsApp'ı öne çıkarıyor, ekstra dikkat çekmeye gerek yok. */
    .whatsapp-float {
        position: fixed;
        width: 60px;
        height: 60px;
        bottom: 80px;
        right: 20px;
        background-color: var(--primary, #E71E24);
        color: #FFF;
        border-radius: 50px;
        text-align: center;
        font-size: 30px;
        box-shadow: var(--shadow-soft-hover, 0 8px 24px rgba(0,0,0,.25));
        z-index: 1001;
    }

    .whatsapp-float a {
        color: #FFF;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
    }

    .whatsapp-float:hover {
        background-color: var(--ink-900, #14151a);
        transform: scale(1.08);
        transition: all 0.3s;
    }

    @media (max-width: 768px) {
        .whatsapp-float {
            width: 50px;
            height: 50px;
            bottom: 20px;
            right: 10px;
            font-size: 24px;
        }

        .footer .navbar-brand img {
            max-height: 60px !important;
            width: auto;
        }
    }
</style>

