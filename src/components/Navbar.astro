---
interface Props {
  activePage?: string;
}

const { activePage = 'index' } = Astro.props;

const isServicesActive = [
  'projeler',
  'muteahhitlik',
  'insaat',
  'pvc',
  'tarim',
  'ziraat',
  'mimar'
].includes(activePage);
---

<!-- Navbar Start -->
<div class="container-fluid sticky-top bg-dark navbar-dark shadow-sm px-2 px-sm-3 px-md-5 pe-lg-0">
    <nav class="navbar navbar-expand-lg py-1 py-lg-0">
        <a href="/" class="navbar-brand me-2">
            <img src="/img/logo.webp" alt="AR-KAR İnşaat Logo" style="max-height:85px; padding: 8px;">
        </a>
        <button class="navbar-toggler ms-auto" type="button" data-bs-toggle="collapse"
            data-bs-target="#navbarCollapse" aria-controls="navbarCollapse" aria-label="Menüyü aç/kapat">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarCollapse">
            <div class="navbar-nav ms-auto py-0">
                <a href="/" class={`nav-item nav-link fw-semibold ${activePage === 'index' ? 'active' : ''}`}>Anasayfa</a>
                <a href="/hakkimizda" class={`nav-item nav-link fw-semibold ${activePage === 'hakkimizda' ? 'active' : ''}`}>Hakkımızda</a>
                <a href={activePage === 'index' ? '#projects' : '/#projects'} class="nav-item nav-link fw-semibold">Projelerimiz</a>
                <a href={activePage === 'index' ? '#dealerships' : '/#dealerships'} class="nav-item nav-link fw-semibold">Bayilikler</a>
                <div class="nav-item dropdown">
                    <a href={activePage === 'index' ? '#service' : '/#service'} class={`nav-link dropdown-toggle fw-semibold ${isServicesActive ? 'active' : ''}`}
                        data-bs-toggle="dropdown">Hizmetler</a>
                    <div class="dropdown-menu m-0">
                        <a href="/projeler" class={`dropdown-item ${activePage === 'projeler' ? 'active' : ''}`}>İnşaat Projeleri</a>
                        <a href="/muteahhitlik" class={`dropdown-item ${activePage === 'muteahhitlik' ? 'active' : ''}`}>Anahtar Teslim İnşaat</a>
                        <a href="/insaat" class={`dropdown-item ${activePage === 'insaat' ? 'active' : ''}`}>Hırdavat & İnşaat Malzemeleri</a>
                        <a href="/pvc" class={`dropdown-item ${activePage === 'pvc' ? 'active' : ''}`}>PVC Kapı ve Pencere Sistemleri</a>
                        <a href="/tarim" class={`dropdown-item ${activePage === 'tarim' ? 'active' : ''}`}>Tarım Ürünleri Alım Satımı</a>
                        <a href="/ziraat" class={`dropdown-item ${activePage === 'ziraat' ? 'active' : ''}`}>Zirai Ürünler ve Danışmanlık</a>
                        <a href="/mimar" class={`dropdown-item ${activePage === 'mimar' ? 'active' : ''}`}>Mimari Proje Hizmetleri</a>
                    </div>
                </div>
                <a href="/haberler" class={`nav-item nav-link fw-semibold ${activePage === 'haberler' ? 'active' : ''}`}>Haberler</a>
                <a href="/sss" class={`nav-item nav-link fw-semibold ${activePage === 'sss' ? 'active' : ''}`}>SSS</a>
                <a href="/iletisim" class={`nav-item nav-link fw-semibold ${activePage === 'iletisim' ? 'active' : ''}`}>İletişim</a>
                <button
                    class="nav-item nav-link bg-primary text-white px-4 px-lg-5 ms-2 ms-lg-3 d-none d-lg-block fw-semibold"
                    style="font-size:1rem; border:none; border-radius: 5px; transition: all 0.3s;"
                    data-bs-toggle="modal" data-bs-target="#contactModal">Bize ulaşın <i
                        class="fa fa-arrow-right" aria-hidden="true"></i></button>
                <div class="d-block d-lg-none w-100 mt-3 px-2">
                    <button class="btn btn-primary w-100 fw-semibold py-3"
                        style="font-size:1rem; border-radius: 8px; box-shadow: 0 2px 10px rgba(231, 30, 36, 0.3);"
                        data-bs-toggle="modal" data-bs-target="#contactModal">
                        <i class="fa fa-phone-alt me-2" aria-hidden="true"></i>Bize ulaşın
                    </button>
                </div>
            </div>
        </div>
    </nav>
</div>
<!-- Navbar End -->

