---
// Kartların üstündeki görsel + rozet bloğu — insaat.astro'nun
// .card-img-container + .material-category-badge deseninin (20+ tekrar)
// tek noktadan yönetilen hâli.
interface Props {
  src: string;
  alt: string;
  aspectRatio?: string;
  loading?: 'lazy' | 'eager';
  /**
   * 'cover' (varsayılan): kutu kenarda boşluk kalmadan tamamen doldurulur,
   * taşan kısım kırpılır — kartlarda "yanda boşluk" bırakmamak öncelikli.
   * 'contain': istisnai durumlar için (görselin TAMAMININ görünmesi asıl
   * amaçsa, ör. bir detay sayfasındaki tek büyük görsel).
   */
  fit?: 'contain' | 'cover';
}

// Varsayılan 1:1 — statik katalog görsellerinin (insaat/pvc/mimar/
// muteahhitlik/tarim/ziraat) büyük çoğunluğu (25 görselden 21'i) zaten
// tam kare (1600×1600). Kutu oranı görselin gerçek oranıyla eşleşince
// 'cover' hiçbir şey kırpmaz — kare olmayan istisnalar çağıran sayfada
// kendi gerçek oranını (ör. aspectRatio="3 / 2") açıkça verir.
const { src, alt, aspectRatio = '1 / 1', loading = 'lazy', fit = 'cover' } = Astro.props;
const hasBadge = Astro.slots.has('badge');
---

<div class="card-media" style={`--card-media-ratio:${aspectRatio};--card-media-fit:${fit}`}>
  {hasBadge && (
    <div class="card-media__badge">
      <slot name="badge" />
    </div>
  )}
  <img src={src} alt={alt} loading={loading} decoding="async" />
</div>
