---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  activePage?: string;
}

const {
  title = "AR-KAR İnşaat Samsun | 36 Yıllık Güvenilir İnşaat, Tarım ve PVC Firması | Çarşamba",
  description = "AR-KAR İnşaat olarak Samsun Çarşamba'da 36 yıldır güvenilir hizmet veriyoruz. Konut inşaat projeleri, anahtar teslim inşaat, PVC kapı-pencere, tarım ürünleri ve zirai ilaç satışı ile kaliteli hizmet sunuyoruz.",
  keywords,
  canonical = "https://ar-kar.com/",
  ogImage = "https://ar-kar.com/img/logo.webp",
  ogType = "website",
  activePage = "index"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">
    <title>{title}</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    {keywords && <meta content={keywords} name="keywords">}
    <meta content={description} name="description">
    <meta name="robots" content="index, follow">
    <meta name="author" content="AR-KAR İnşaat">
    <meta name="geo.region" content="TR-55">
    <meta name="geo.placename" content="Çarşamba, Samsun">
    <meta name="geo.position" content="41.1986;36.7153">
    <meta name="ICBM" content="41.1986, 36.7153">
    <link rel="canonical" href={canonical}>

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content={ogType}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:locale" content="tr_TR">
    <meta property="og:site_name" content="AR-KAR İnşaat">

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImage}>

    <!-- Favicon -->
    <link href="/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&family=Roboto:wght@500;700&display=swap"
        rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com">
    <link rel="preconnect" href="https://cdn.jsdelivr.net">
    <link rel="preconnect" href="https://code.jquery.com">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">
    <link href="/lib/tempusdominus/css/tempusdominus-bootstrap-4.min.css" rel="stylesheet" />
    <link href="/lib/lightbox/css/lightbox.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/css/bootstrap.red.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/css/style.css" rel="stylesheet">

    <!-- Humans.txt -->
    <link type="text/plain" rel="author" href="/humans.txt">

    <!-- Security Headers (meta tags) -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff">
    <meta http-equiv="X-Frame-Options" content="DENY">
    <meta http-equiv="X-XSS-Protection" content="1; mode=block">
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin">

    <slot name="head" />
</head>

<body>
    <Navbar activePage={activePage} />

    <slot />

    <Footer />

    <!-- JavaScript Libraries -->
    <script is:inline src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script is:inline src="/lib/easing/easing.min.js"></script>
    <script is:inline src="/lib/waypoints/waypoints.min.js"></script>
    <script is:inline src="/lib/owlcarousel/owl.carousel.min.js"></script>
    <script is:inline src="/lib/tempusdominus/js/moment.min.js"></script>
    <script is:inline src="/lib/tempusdominus/js/moment-timezone.min.js"></script>
    <script is:inline src="/lib/tempusdominus/js/tempusdominus-bootstrap-4.min.js"></script>
    <script is:inline src="/lib/isotope/isotope.pkgd.min.js"></script>
    <script is:inline src="/lib/lightbox/js/lightbox.min.js"></script>

    <!-- Template Javascript -->
    <script is:inline src="/js/main.js"></script>
</body>

</html>

