---
import { EXPERIENCE_YEARS } from '../lib/company';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  activePage?: string;
}

const {
  title = `AR-KAR İnşaat Samsun | ${EXPERIENCE_YEARS} Yıllık Güvenilir İnşaat, Tarım ve PVC Firması | Çarşamba`,
  description = `AR-KAR İnşaat olarak Samsun Çarşamba'da ${EXPERIENCE_YEARS} yıldır güvenilir hizmet veriyoruz. Konut inşaat projeleri, anahtar teslim inşaat, PVC kapı-pencere, tarım ürünleri ve zirai ilaç satışı ile kaliteli hizmet sunuyoruz.`,
  keywords,
  canonical = "https://ar-kar.com/",
  // Varsayılan paylaşım görseli. Eskiden logo.webp (422×173) veriliyor ama
  // aşağıda 1200×630 olduğu BEYAN ediliyordu; Facebook/WhatsApp bu yüzden
  // görseli yanlış orana zorlayıp kırpıyordu. og-default.webp gerçekten
  // 1200×630'dur.
  ogImage = "https://ar-kar.com/img/og-default.webp",
  ogType = "website",
  activePage = "index"
} = Astro.props;

// --------------------------------------------------------------------------
// Ortam farkındalığı (bkz. astro.config.mjs)
// --------------------------------------------------------------------------
// Staging, canlı sitenin birebir kopyasıdır. Arama motorlarına açık
// bırakılırsa Google iki ayrı adreste aynı içeriği görür. Bu yüzden
// production dışındaki her derleme noindex ile işaretlenir; robots.txt de
// aynı değişkene bakarak tüm siteyi taramaya kapatır.
const DEPLOY_ENV = import.meta.env.PUBLIC_DEPLOY_ENV ?? 'production';
const isProduction = DEPLOY_ENV === 'production';

// Sayfalar canonical'ı tam adresle veriyor (https://ar-kar.com/...).
// Origin'i bulunulan ortamın adresiyle değiştiriyoruz; yol kısmı korunur.
// Böylece 12 sayfayı tek tek düzenlemeden canonical ortama uyum sağlar.
const canonicalUrl = new URL(
  new URL(canonical).pathname,
  Astro.site ?? 'https://ar-kar.com'
).href;

// og:image:width/height yalnızca boyutunu KESİN bildiğimiz varsayılan
// görsel için yazılır. İçerikten gelen kapak görselleri her boyutta
// olabilir; onlar için yanlış boyut beyan etmek kırpılmaya yol açar.
const isDefaultOgImage = ogImage.endsWith('/img/og-default.webp');
---

<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">
    <title>{title}</title>
    <meta content="width=device-width, initial-scale=1.0, viewport-fit=cover" name="viewport">
    {keywords && <meta content={keywords} name="keywords">}
    <meta content={description} name="description">
    <meta name="robots" content={isProduction ? "index, follow" : "noindex, nofollow"}>
    <meta name="author" content="AR-KAR İnşaat">
    <meta name="theme-color" content="#000000">
    <meta name="geo.region" content="TR-55">
    <meta name="geo.placename" content="Çarşamba, Samsun">
    <meta name="geo.position" content="41.1986;36.7153">
    <meta name="ICBM" content="41.1986, 36.7153">
    <link rel="canonical" href={canonicalUrl}>

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content={ogType}>
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:image" content={ogImage}>
    {isDefaultOgImage && (
      <Fragment>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </Fragment>
    )}
    <meta property="og:locale" content="tr_TR">
    <meta property="og:site_name" content="AR-KAR İnşaat">

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImage}>

    <!-- Favicon -->
    <link href="/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts: Plus Jakarta Sans (başlıklar) + Inter (gövde metni) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet">

    {/* İkon fontu — tek bir set kullanılır.
         Bootstrap Icons kaldırıldı: sitede yalnızca 9 yerde kullanılıyordu
         (Font Awesome'da 172) ve ikinci bir font + ikinci bir CDN bağlantısı
         maliyetine değmiyordu. O 9 ikon Font Awesome karşılıklarıyla
         değiştirildi. */}
    <link rel="preconnect" href="https://cdnjs.cloudflare.com">
    <link rel="preconnect" href="https://cdn.jsdelivr.net">
    <link rel="preconnect" href="https://code.jquery.com">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.0/css/all.min.css" rel="stylesheet">

    {/* Kütüphane stilleri — yalnızca gerçekten kullanılan lightbox kaldı.
         owlcarousel ve tempusdominus kaldırıldı; sitede bu bileşenlerden
         hiçbiri yoktu (bkz. public/js/main.js başındaki not). */}
    <link href="/lib/lightbox/css/lightbox.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/css/bootstrap.red.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/css/style.css" rel="stylesheet">

    <!-- Tasarım sistemi v2: renk paleti + tipografi (style.css'ten sonra) -->
    <link href="/css/design-system.css" rel="stylesheet">

    <!-- Bento grid bileşenleri (yalnızca ana sayfada kullanılır ama küçük, her sayfaya yüklenmesi zararsız) -->
    <link href="/css/bento.css" rel="stylesheet">

    <!-- Akışkan responsive katmanı (en son yüklenmeli) -->
    <link href="/css/responsive.css" rel="stylesheet">

    <!-- Humans.txt -->
    <link type="text/plain" rel="author" href="/humans.txt">

    {/* Güvenlik başlıkları: public/_headers dosyasında GERÇEK HTTP başlığı
         olarak tanımlıdır. X-Frame-Options ve X-Content-Type-Options
         <meta http-equiv> ile verildiğinde tarayıcılar tarafından YOK SAYILIR;
         bu yüzden burada meta olarak tekrarlanmaz. */}

    <slot name="head" />
</head>

<body>
    {/* Önizleme ortamlarında (staging / yerel dev) canlı siteyle karıştırılmasın
        diye şerit. Navbar sticky olduğu için bu şerit BİLEREK sticky değildir;
        ikisi birden üstte sabitlenirse üst üste biner. */}
    {!isProduction && (
      <div class="env-banner" role="status">
        <style is:inline set:html={`
          .env-banner {
            display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
            gap: .25rem .75rem;
            padding: .5rem 1rem;
            background: repeating-linear-gradient(45deg, #1f2430, #1f2430 12px, #2a3140 12px, #2a3140 24px);
            color: #fff; font-size: .82rem; line-height: 1.4; text-align: center;
          }
          .env-banner strong { color: #f0b429; letter-spacing: .06em; }
          .env-banner code { background: rgba(255,255,255,.14); padding: .05rem .35rem; border-radius: 4px; }
          .env-banner a { color: #fff; text-decoration: underline; white-space: nowrap; }
        `} />
        <strong>ÖNİZLEME ORTAMI</strong>
        <span>Bu adres <code>{DEPLOY_ENV}</code> kopyasıdır — arama motorlarına kapalıdır, canlı site değildir.</span>
        <a href="https://ar-kar.com">Canlı siteye git →</a>
      </div>
    )}

    <Navbar activePage={activePage} />

    <slot />

    <Footer />

    {/* JavaScript kütüphaneleri
         ------------------------------------------------------------------
         Buradan kaldırılanlar (hepsi hiçbir işe yaramadan her sayfaya
         yükleniyordu, toplam ~900 KB):
           easing, waypoints, owlcarousel, moment, moment-timezone,
           tempusdominus, isotope
         Gerekçe ve ayrıntı: public/js/main.js dosyasının başındaki not.

         Kalanlar:
           jQuery    — lightbox2 ve main.js bunu zorunlu kılıyor
           bootstrap — modal, dropdown, collapse, carousel, accordion
           lightbox  — proje ve haber galerilerinde gerçekten kullanılıyor
         `defer` ile yüklenirler: HTML ayrıştırmasını bloklamazlar ama
         yazıldıkları sırayla çalışırlar (jQuery önce, main.js en son). */}
    <script is:inline defer src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script is:inline defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script is:inline defer src="/lib/lightbox/js/lightbox.min.js"></script>
    <script is:inline defer src="/js/main.js"></script>
</body>

</html>

