---
import { COLLECTIONS } from '../lib/cms-schema';
import { getAccessIdentity } from '../lib/access';

// Sunucu tarafında render edilir: böylece middleware devreye girer ve bu sayfa
// yalnızca panel host'unda servis edilir (statik olsaydı assets binding
// tarafından her host'ta sunulurdu).
export const prerender = false;

const identity = getAccessIdentity(Astro.request);
const schema = JSON.stringify(COLLECTIONS);
---

<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <title>AR-KAR İçerik Paneli</title>
  <link rel="icon" href="/favicon.ico" />
  <style>
    :root {
      --bg: #f5f6f8;
      --card: #ffffff;
      --ink: #14161a;
      --muted: #6b7280;
      --line: #e4e6eb;
      --brand: #cc272b;
      --ok: #16794c;
      --danger: #b42318;
      color-scheme: light;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font: 15px/1.55 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }
    header {
      background: #14161a; color: #fff;
      padding: calc(14px + env(safe-area-inset-top, 0px)) 16px 14px;
      display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
      position: sticky; top: 0; z-index: 20;
    }
    header h1 { font-size: 1rem; margin: 0; font-weight: 700; letter-spacing: .02em; }
    header .who { margin-left: auto; font-size: .8rem; color: #9ca3af; }
    .wrap { max-width: 820px; margin: 0 auto; padding: 16px; }
    .tabs { display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap; }
    .tab {
      border: 1px solid var(--line); background: var(--card); color: var(--ink);
      padding: 9px 16px; border-radius: 999px; cursor: pointer; font-size: .9rem; font-weight: 600;
    }
    .tab[aria-selected="true"] { background: var(--brand); border-color: var(--brand); color: #fff; }
    .card {
      background: var(--card); border: 1px solid var(--line);
      border-radius: 12px; padding: 16px; margin-bottom: 16px;
    }
    .card h2 { margin: 0 0 12px; font-size: .95rem; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
    label { display: block; font-weight: 600; font-size: .85rem; margin: 0 0 6px; }
    input[type=text], input[type=date], textarea, select, input[type=file] {
      width: 100%; padding: 10px 12px; border: 1px solid var(--line);
      border-radius: 8px; font: inherit; background: #fff; color: var(--ink);
    }
    textarea { resize: vertical; }
    .field { margin-bottom: 14px; }
    .hint { font-size: .78rem; color: var(--muted); margin-top: 4px; }
    .row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
    button {
      font: inherit; font-weight: 600; border-radius: 8px; padding: 10px 18px;
      border: 1px solid transparent; cursor: pointer;
    }
    .primary { background: var(--brand); color: #fff; }
    .ghost { background: #fff; border-color: var(--line); color: var(--ink); }
    .danger { background: #fff; border-color: #f3c4c0; color: var(--danger); }
    button:disabled { opacity: .55; cursor: not-allowed; }
    ul.entries { list-style: none; margin: 0; padding: 0; }
    ul.entries li {
      display: flex; gap: 10px; align-items: center; flex-wrap: wrap;
      padding: 11px 0; border-bottom: 1px solid var(--line);
    }
    ul.entries li:last-child { border-bottom: 0; }
    .entry-main { flex: 1 1 220px; min-width: 0; }
    .entry-title { font-weight: 600; }
    .entry-meta { font-size: .78rem; color: var(--muted); }
    .msg { padding: 11px 14px; border-radius: 8px; margin-bottom: 14px; font-size: .9rem; display: none; }
    .msg.ok { display: block; background: #e7f6ef; color: var(--ok); border: 1px solid #bfe5d2; }
    .msg.err { display: block; background: #fdeceb; color: var(--danger); border: 1px solid #f5c9c5; }
    .empty { color: var(--muted); font-size: .9rem; padding: 10px 0; }
    img.preview { max-width: 180px; border-radius: 8px; margin-top: 8px; display: block; }
    @media (max-width: 480px) {
      .wrap { padding: 12px; }
      button { width: 100%; }
      .row button { width: auto; flex: 1 1 auto; }
    }
  </style>
</head>
<body>
  <header>
    <h1>AR-KAR İçerik Paneli</h1>
    <span class="who">{identity ? identity.email : 'oturum bilgisi yok'}</span>
  </header>

  <div class="wrap">
    <div class="msg" id="msg"></div>

    <div class="tabs" id="tabs" role="tablist"></div>

    <div class="card">
      <h2 id="listTitle">Kayıtlar</h2>
      <ul class="entries" id="entries"></ul>
      <div class="empty" id="listEmpty">Yükleniyor…</div>
    </div>

    <div class="card">
      <h2 id="formTitle">Yeni Kayıt</h2>
      <form id="form" novalidate>
        <div id="fields"></div>
        <div class="row">
          <button type="submit" class="primary" id="saveBtn">Yayınla</button>
          <button type="button" class="ghost" id="resetBtn">Temizle</button>
        </div>
        <div class="hint">
          Kaydettiğinizde içerik doğrudan <code>production</code> dalına commit edilir;
          testler geçtikten sonra site otomatik güncellenir (1-2 dakika).
        </div>
      </form>
    </div>
  </div>

  <script define:vars={{ schema }} is:inline>
    const COLLECTIONS = JSON.parse(schema);
    const keys = Object.keys(COLLECTIONS);
    let current = keys[0];
    let editingSlug = null;

    const $ = (id) => document.getElementById(id);
    const msg = $('msg');

    function showMsg(text, kind) {
      msg.textContent = text;
      msg.className = 'msg ' + kind;
      if (kind === 'ok') setTimeout(() => { msg.className = 'msg'; }, 6000);
    }

    function today() {
      return new Date().toISOString().slice(0, 10);
    }

    function renderTabs() {
      $('tabs').innerHTML = keys.map((k) =>
        `<button class="tab" role="tab" data-key="${k}" aria-selected="${k === current}">${COLLECTIONS[k].label}</button>`
      ).join('');
      $('tabs').querySelectorAll('.tab').forEach((b) => {
        b.onclick = () => { current = b.dataset.key; editingSlug = null; renderAll(); };
      });
    }

    function renderFields(values) {
      values = values || {};
      const col = COLLECTIONS[current];
      $('fields').innerHTML = col.fields.map((f) => {
        const v = values[f.name] != null ? String(values[f.name]) : (f.type === 'date' ? today() : '');
        const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
        const req = f.required ? 'required' : '';
        let input;
        if (f.type === 'textarea') {
          input = `<textarea id="f_${f.name}" rows="3" ${req}>${esc(v)}</textarea>`;
        } else if (f.type === 'markdown') {
          input = `<textarea id="f_${f.name}" rows="12" placeholder="${esc(f.placeholder || '')}" ${req}>${esc(v)}</textarea>`;
        } else if (f.type === 'select') {
          input = `<select id="f_${f.name}" ${req}>` +
            f.options.map((o) => `<option value="${esc(o.value)}" ${o.value === v ? 'selected' : ''}>${esc(o.label)}</option>`).join('') +
            `</select>`;
        } else if (f.type === 'image') {
          input = `<input type="file" id="f_${f.name}_file" accept="image/*" />
            <input type="hidden" id="f_${f.name}" value="${esc(v)}" />
            ${v ? `<img class="preview" src="${esc(v)}" alt="" />` : ''}
            <div class="hint">Boş bırakırsanız mevcut görsel korunur. En fazla 5 MB.</div>`;
        } else if (f.type === 'date') {
          input = `<input type="date" id="f_${f.name}" value="${esc(v)}" ${req} />`;
        } else {
          input = `<input type="text" id="f_${f.name}" value="${esc(v)}" placeholder="${esc(f.placeholder || '')}" ${req} />`;
        }
        return `<div class="field"><label for="f_${f.name}">${f.label}${f.required ? ' *' : ''}</label>${input}</div>`;
      }).join('');
      $('formTitle').textContent = editingSlug ? `Düzenleniyor: ${editingSlug}` : 'Yeni Kayıt';
    }

    async function loadEntries() {
      $('entries').innerHTML = '';
      $('listEmpty').textContent = 'Yükleniyor…';
      $('listEmpty').style.display = 'block';
      $('listTitle').textContent = COLLECTIONS[current].label;
      try {
        const res = await fetch(`/api/cms/entries?collection=${current}`);
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Liste alınamadı');
        if (!data.entries.length) {
          $('listEmpty').textContent = 'Henüz kayıt yok.';
          return;
        }
        $('listEmpty').style.display = 'none';
        $('entries').innerHTML = data.entries.map((e) => `
          <li>
            <div class="entry-main">
              <div class="entry-title">${e.title}</div>
              <div class="entry-meta">${e.date || ''} · ${e.slug}</div>
            </div>
            <button class="ghost" data-edit="${e.slug}">Düzenle</button>
            <button class="danger" data-del="${e.slug}">Sil</button>
          </li>`).join('');

        $('entries').querySelectorAll('[data-edit]').forEach((b) => {
          b.onclick = () => editEntry(b.dataset.edit);
        });
        $('entries').querySelectorAll('[data-del]').forEach((b) => {
          b.onclick = () => deleteEntry(b.dataset.del);
        });
      } catch (err) {
        $('listEmpty').textContent = 'Hata: ' + err.message;
      }
    }

    async function editEntry(slug) {
      try {
        const res = await fetch(`/api/cms/entries?collection=${current}&slug=${encodeURIComponent(slug)}`);
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Kayıt alınamadı');
        editingSlug = slug;
        renderFields({ ...data.data, body: data.body });
        window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
      } catch (err) {
        showMsg(err.message, 'err');
      }
    }

    async function deleteEntry(slug) {
      if (!confirm(`"${slug}" kaydı silinecek. Emin misiniz?`)) return;
      try {
        const res = await fetch('/api/cms/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ collection: current, slug }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Silinemedi');
        showMsg('Kayıt silindi. Site birkaç dakika içinde güncellenecek.', 'ok');
        if (editingSlug === slug) { editingSlug = null; renderFields(); }
        loadEntries();
      } catch (err) {
        showMsg(err.message, 'err');
      }
    }

    function readFileAsDataUrl(file) {
      return new Promise((resolve, reject) => {
        const r = new FileReader();
        r.onload = () => resolve(r.result);
        r.onerror = reject;
        r.readAsDataURL(file);
      });
    }

    $('form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = $('saveBtn');
      btn.disabled = true;
      const label = btn.textContent;
      btn.textContent = 'Kaydediliyor…';

      try {
        const col = COLLECTIONS[current];
        const payload = { collection: current };
        if (editingSlug) payload.slug = editingSlug;

        for (const f of col.fields) {
          const el = $(`f_${f.name}`);
          if (el) payload[f.name] = el.value;
          if (f.type === 'image') {
            const fileEl = $(`f_${f.name}_file`);
            if (fileEl && fileEl.files && fileEl.files[0]) {
              payload.imageBase64 = await readFileAsDataUrl(fileEl.files[0]);
              payload.imageName = fileEl.files[0].name;
            }
          }
        }

        const res = await fetch('/api/cms/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Kaydedilemedi');

        showMsg('Kaydedildi. Testler geçtikten sonra site güncellenecek (1-2 dk).', 'ok');
        editingSlug = null;
        renderFields();
        loadEntries();
      } catch (err) {
        showMsg(err.message, 'err');
      } finally {
        btn.disabled = false;
        btn.textContent = label;
      }
    });

    $('resetBtn').onclick = () => { editingSlug = null; renderFields(); };

    function renderAll() {
      renderTabs();
      renderFields();
      loadEntries();
    }

    renderAll();
  </script>
</body>
</html>
