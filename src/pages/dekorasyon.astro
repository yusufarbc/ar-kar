---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "AR-KAR Dekorasyon Hizmetleri | İç Mekan Tasarımı ve Dekor | Samsun Çarşamba";
const description = "AR-KAR İnşaat Dekorasyon Hizmetleri ile Samsun Çarşamba'da iç mekan tasarımı, ev dekorasyonu, duvar boyası, zemin kaplama ve aydınlatma çözümleri. Yaşam alanlarınızı güzelleştiren kaliteli dekorasyon malzemeleri.";
const canonical = "https://ar-kar.com/dekorasyon";
const ogImage = "https://ar-kar.com/img/dekorasyon.webp";
const keywords = "ar-kar dekorasyon, iç mekan tasarımı, ev dekorasyonu, duvar boyası, zemin kaplama, samsun dekorasyon, çarşamba dekor, aydınlatma, mobilya";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  keywords={keywords}
  activePage="dekorasyon"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={`{
        "@context": "https://schema.org",
        "@type": "Service",
        "name": "AR-KAR Dekorasyon Hizmetleri",
        "description": "Samsun Çarşamba'da iç mekan tasarımı, ev dekorasyonu ve dekorasyon malzemeleri ile yaşam alanlarınızı güzelleştiriyoruz.",
        "provider": {
            "@type": "Organization",
            "name": "AR-KAR İnşaat Gıda Tarım Ürünleri ve Taş. Tic. Ltd. Şti.",
            "address": {
                "@type": "PostalAddress",
                "streetAddress": "Orta Mah. Dr. Orhan Atılgan Cad. No:24/A",
                "addressLocality": "Çarşamba",
                "addressRegion": "Samsun",
                "addressCountry": "TR"
            },
            "telephone": "+90 362 846 03 93",
            "email": "arkargida@gmail.com"
        },
        "areaServed": "Samsun, Türkiye",
        "serviceType": "Dekorasyon Hizmetleri",
        "offers": [
            {
                "@type": "Offer",
                "name": "İç Mekan Tasarımı",
                "description": "Profesyonel iç mekan tasarımı ve dekorasyon danışmanlığı"
            },
            {
                "@type": "Offer", 
                "name": "Dekorasyon Malzemeleri",
                "description": "Kaliteli duvar boyası, zemin kaplama ve dekorasyon ürünleri"
            },
            {
                "@type": "Offer",
                "name": "Aydınlatma Çözümleri",
                "description": "Modern ve estetik aydınlatma sistemleri"
            }
        ]
    }`} />
    <style is:inline set:html={`/* Critical CSS for above-the-fold content */
        .navbar-brand img {
            transition: transform 0.3s ease;
        }
        
        .navbar-brand img:hover {
            transform: scale(1.05);
        }

        /* Lazy Loading Enhancement */
        img[loading="lazy"] {
            transition: opacity 0.3s ease;
        }

        /* Decoration service cards */
        .decoration-card {
            background: white;
            border-radius: 20px;
            padding: 2rem;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
            text-align: center;
            height: 100%;
            position: relative;
            overflow: hidden;
        }

        .decoration-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 5px;
            background: linear-gradient(90deg, var(--bs-primary), var(--bs-warning), var(--bs-info));
        }

        .decoration-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 25px 50px rgba(0,0,0,0.15);
        }

        .decoration-icon {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--bs-primary), var(--bs-warning));
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
            font-size: 2.5rem;
        }

        /* Color palette showcase */
        .color-palette {
            display: flex;
            justify-content: center;
            margin: 2rem 0;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .color-swatch {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
            transition: transform 0.3s ease;
            cursor: pointer;
        }

        .color-swatch:hover {
            transform: scale(1.2);
        }

        /* Material samples */
        .material-sample {
            background: white;
            border-radius: 15px;
            padding: 1.5rem;
            text-align: center;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
            margin-bottom: 1rem;
        }

        .material-sample:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.15);
        }

        .material-icon {
            font-size: 3rem;
            color: var(--bs-primary);
            margin-bottom: 1rem;
        }

        /* Design inspiration gallery */
        .inspiration-gallery {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin: 3rem 0;
        }

        .inspiration-item {
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            transition: transform 0.3s ease;
            position: relative;
        }

        .inspiration-item:hover {
            transform: scale(1.05);
        }

        .inspiration-item img {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

        .inspiration-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(transparent, rgba(0,0,0,0.8));
            color: white;
            padding: 1rem;
            transform: translateY(100%);
            transition: transform 0.3s ease;
        }

        .inspiration-item:hover .inspiration-overlay {
            transform: translateY(0);
        }

        /* Style categories */
        .style-category {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            border-radius: 15px;
            padding: 2rem;
            margin-bottom: 2rem;
            text-align: center;
        }

        .category-icon {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: var(--bs-primary);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem;
            font-size: 2rem;
        }

        /* Accessibility improvements */
        .btn:focus,
        .nav-link:focus,
        .decoration-card:focus,
        .color-swatch:focus {
            outline: 2px solid var(--bs-primary);
            outline-offset: 2px;
        }

        /* Reduced motion support */
        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
        }

        /* Mobile optimizations */
        @media (max-width: 768px) {
            .decoration-card {
                padding: 1.5rem;
            }
            
            .style-category {
                padding: 1.5rem;
            }
            
            .inspiration-gallery {
                grid-template-columns: 1fr;
                gap: 1rem;
            }
            
            .color-palette {
                gap: 0.5rem;
            }
            
            .color-swatch {
                width: 50px;
                height: 50px;
            }
            
            .display-5 {
                font-size: 2rem;
            }
            
            .py-6 {
                padding-top: 3rem !important;
                padding-bottom: 3rem !important;
            }
            
            .footer .navbar-brand img {
                max-height: 60px !important;
                width: auto;
            }
        }

        /* Tablet optimizations */
        @media (min-width: 769px) and (max-width: 1024px) {
            .inspiration-gallery {
                grid-template-columns: repeat(2, 1fr);
            }
        }
        
        /* WhatsApp floating button */
        .whatsapp-float {
            position: fixed;
            width: 60px;
            height: 60px;
            bottom: 20px;
            right: 20px;
            background-color: #25d366;
            color: white;
            border-radius: 50px;
            text-align: center;
            font-size: 30px;
            box-shadow: 2px 2px 3px #999;
            z-index: 1000;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
        }
        
        .whatsapp-float:hover {
            background-color: #20c55e;
            color: white;
            transform: scale(1.1);
            text-decoration: none;
        }
        
        @media (max-width: 768px) {
            .whatsapp-float {
                width: 55px;
                height: 55px;
                bottom: 15px;
                right: 15px;
                font-size: 25px;
            }
        }`} />
  </Fragment>

  <!-- Breadcrumb Start -->
    <div class="container-fluid bg-dark py-3 px-sm-3 px-md-5">
        <div class="row">
            <div class="col-md-12">
