---
import PageHeader from '../../components/PageHeader.astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => {
    const slug = post.id.replace(/\/index$/, '');
    return {
      params: { slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { slug } = Astro.params;
const { Content } = await render(post);

const title = `${post.data.title} | AR-KAR İnşaat`;
const description = post.data.description || `${post.data.title} - AR-KAR İnşaat'tan haber.`;
const canonical = `https://ar-kar.com/haberler/${slug}`;
const coverImage = post.data.coverImage || '/img/about.webp';

// Haber yazılarında hiç yapısal veri yoktu; arama sonuçlarında tarih, yazar
// ve görsel bilgisi taşıyan makale kartları bu şema olmadan oluşmuyor.
const origin = (Astro.site ?? new URL('https://ar-kar.com')).origin;
const absolute = (p: string) => (p.startsWith('http') ? p : new URL(p, origin).href);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description,
  image: absolute(coverImage),
  datePublished: post.data.date,
  dateModified: post.data.date,
  inLanguage: 'tr-TR',
  mainEntityOfPage: { '@type': 'WebPage', '@id': absolute(`/haberler/${slug}`) },
  author: { '@type': 'Organization', name: 'AR-KAR İnşaat', url: origin },
  publisher: {
    '@type': 'Organization',
    name: 'AR-KAR İnşaat',
    logo: { '@type': 'ImageObject', url: absolute('/img/logo.webp') },
  },
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={coverImage}
  ogType="article"
  activePage="haberler"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
  </Fragment>

  <PageHeader active={post.data.title} parents={[{ label: "Haberler", href: "/haberler" }]} />

  <!-- Blog Detail Start -->
  <article class="container py-6">
    <div class="row justify-content-center">
      <div class="col-lg-9">
        <header class="mb-4">
          <div class="d-flex align-items-center text-muted mb-3">
            <span class="me-3"><i class="fa fa-calendar-alt text-primary me-2" aria-hidden="true"></i>{post.data.date}</span>
            <span><i class="fa fa-user text-primary me-2" aria-hidden="true"></i>AR-KAR İnşaat</span>
          </div>
          <h1 class="display-6 fw-bold text-dark mb-4">{post.data.title}</h1>
          {post.data.description && (
            <p class="lead text-secondary border-start border-4 border-primary ps-3 py-1 mb-4">
              {post.data.description}
            </p>
          )}
        </header>

        {post.data.coverImage && (
          <div class="mb-5 rounded overflow-hidden shadow-sm" style="background: var(--surface-alt);">
            <img
              src={coverImage}
              alt={post.data.title}
              class="w-100 img-fluid"
              style="max-height: 480px; object-fit: contain;"
            />
          </div>
        )}

        <div class="blog-content prose" style="font-size: 1.1rem; line-height: 1.8;">
          <Content />
        </div>

        {post.data.gallery && post.data.gallery.length > 0 && (
          <div class="mb-5">
            <h2 class="h5 text-uppercase mb-3">Galeri</h2>
            <div class="row g-3">
              {post.data.gallery.map((img) => (
                <div class="col-6 col-md-4">
                  <a href={img} data-lightbox="blog-gallery" class="d-block rounded overflow-hidden shadow-sm" style="background: var(--surface-alt);">
                    <img src={img} alt={post.data.title} class="w-100" style="aspect-ratio: 4 / 5; object-fit: cover;" loading="lazy" />
                  </a>
                </div>
              ))}
            </div>
          </div>
        )}

        <hr class="my-5" />

        <div class="d-flex justify-content-between align-items-center">
          <a href="/haberler" class="btn btn-outline-primary">
            <i class="fa fa-arrow-left me-2" aria-hidden="true"></i>Tüm Haberler
          </a>
          <button
            type="button"
            class="btn btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#contactModal"
          >
            <i class="fa fa-envelope me-2" aria-hidden="true"></i>Bize Danışın
          </button>
        </div>
      </div>
    </div>
  </article>
  <!-- Blog Detail End -->
</BaseLayout>

<style is:inline>
  .blog-content h2, .blog-content h3, .blog-content h4 {
    color: var(--ink-900);
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-weight: 700;
  }
  .blog-content p {
    margin-bottom: 1.25rem;
    color: var(--ink-700);
  }
  .blog-content ul, .blog-content ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }
  .blog-content li {
    margin-bottom: 0.5rem;
    color: var(--ink-700);
  }
  .blog-content img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 1.5rem 0;
  }
</style>

