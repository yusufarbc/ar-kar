---
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Card from '../../components/ui/Card.astro';
import CardMedia from '../../components/ui/CardMedia.astro';
import Badge from '../../components/ui/Badge.astro';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => {
  const dateA = new Date(a.data.date).getTime();
  const dateB = new Date(b.data.date).getTime();
  return dateB - dateA;
});

const title = "Haberler | AR-KAR İnşaat Samsun";
const description = "AR-KAR İnşaat'tan güncel haberler: yeni bayilikler, projeler ve paylaşımlar. Samsun inşaat sektörü, tarım ve yapı malzemeleri hakkında güncel gelişmeler.";
const canonical = "https://ar-kar.com/haberler";

// Haber listesinde yapısal veri yoktu. Blog + blogPost listesi, arama
// motorlarına bu sayfanın bir yayın akışı olduğunu ve hangi yazıları
// içerdiğini doğrudan bildirir.
const origin = (Astro.site ?? new URL('https://ar-kar.com')).origin;

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'AR-KAR İnşaat — Haberler',
  description,
  url: new URL('/haberler', origin).href,
  inLanguage: 'tr-TR',
  publisher: { '@type': 'Organization', name: 'AR-KAR İnşaat', url: origin },
  blogPost: sortedPosts.map((post) => {
    const slug = post.id.replace(/\/index$/, '');
    return {
      '@type': 'BlogPosting',
      headline: post.data.title,
      datePublished: post.data.date,
      url: new URL(`/haberler/${slug}`, origin).href,
    };
  }),
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  activePage="haberler"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(blogSchema)} />
  </Fragment>

  <PageHeader active="Haberler" />

  <!-- Blog List Start -->
  <div class="container-fluid py-6 px-5 bg-light">
    <SectionHeader accent="Bizden" title="Haberler" lede="AR-KAR İnşaat'tan güncel paylaşımlar ve projeler" />

    <div class="container">
      {sortedPosts.length === 0 ? (
        <div class="text-center py-5">
          <p class="lead text-muted">Henüz yayınlanmış bir haber bulunmamaktadır.</p>
        </div>
      ) : (
        <div class="row g-4">
          {sortedPosts.map((post) => {
            const slug = post.id.replace(/\/index$/, '');
            const postUrl = `/haberler/${slug}`;
            const coverImage = post.data.coverImage || '/img/about.webp';

            return (
              <div class="col-12 col-md-6 col-lg-4">
                <Card padded={false} class="h-100 d-flex flex-column">
                  <a href={postUrl}>
                    <CardMedia src={coverImage} alt={post.data.title} aspectRatio="4 / 5">
                      <Badge slot="badge" label={post.data.date} icon="fa-calendar-alt" />
                    </CardMedia>
                  </a>
                  <div class="card-surface__body flex-grow-1 d-flex flex-column">
                    <h2 class="h5 mb-3">
                      <a href={postUrl} class="text-reset text-decoration-none">
                        {post.data.title}
                      </a>
                    </h2>
                    {post.data.description && (
                      <p class="text-muted mb-4 flex-grow-1" style="font-size: 0.95rem; line-height: 1.6;">
                        {post.data.description}
                      </p>
                    )}
                    <div class="mt-auto pt-3 border-top">
                      <a href={postUrl} class="btn btn-sm btn-primary px-3">
                        Devamını Oku <i class="fa fa-arrow-right ms-1" aria-hidden="true"></i>
                      </a>
                    </div>
                  </div>
                </Card>
              </div>
            );
          })}
        </div>
      )}
    </div>
  </div>
  <!-- Blog List End -->
</BaseLayout>

