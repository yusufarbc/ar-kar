---
import { getCollection } from 'astro:content';
import { COMPANY, EXPERIENCE_YEARS } from '../lib/company';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Card from '../components/ui/Card.astro';

const allProjects = await getCollection('projects');

// Ana sayfadaki 8 proje kartı eskiden koleksiyondan bağımsız, elle
// yazılmıştı (projeler.astro'nunkinden AYRI bir veri kaynağı) — tıpkı
// "tecrübe yılı" ve "proje sayısı"nın daha önce elle yazılıp yanlış
// düşmesi gibi bir "iki gerçeklik kaynağı" riskiydi. Artık aynı koleksiyon
// kullanılıyor, en güncel 8 kayıt gösteriliyor.
//
// NOT: "insaat" slug'lı kayıt panelden atılmış görünen bir deneme
// kaydı (başlık "inşaat", açıklama "proje") — ana sayfada gerçek bir
// proje gibi görünmemesi için burada bilerek dışlandı. Kalıcı çözüm
// panelden bu kaydın silinmesi; bkz. panel > Projeler.
const homeProjects = allProjects
  .filter((p) => p.id.replace(/\/index$/, '') !== 'insaat')
  .sort((a, b) => String(b.data.date ?? '').localeCompare(String(a.data.date ?? '')))
  .slice(0, 8);

// İş ortağı markalar. Eskiden 19 logo tek tek dönen bir carousel içindeydi;
// ziyaretçi hepsini görmek için ~95 saniye beklemek zorundaydı. Artık hepsi
// tek bakışta görünen statik bir ızgarada.
const PARTNERS = [
  { src: '/img/1.webp', name: "Polisan Boya" },
  { src: '/img/2.webp', name: "Deckon" },
  { src: '/img/3.webp', name: "Atakum Kimya" },
  { src: '/img/4.webp', name: "Kale Seramik" },
  { src: '/img/5.webp', name: "Termal Seramik" },
  { src: '/img/6.webp', name: "Rino" },
  { src: '/img/7.webp', name: "Kavçim Çimento" },
  { src: '/img/8.webp', name: "ABS" },
  { src: '/img/9.webp', name: "DOĞUPEN" },
  { src: '/img/10.webp', name: "KARPEN" },
  { src: '/img/11.webp', name: "Gemlik Gübre" },
  { src: '/img/12.webp', name: "İGSAŞ" },
  { src: '/img/13.webp', name: "Peli Parke" },
  { src: '/img/14.webp', name: "M&R" },
  { src: '/img/15.webp', name: "Turavit" },
  { src: '/img/16.webp', name: "KYK" },
  { src: '/img/17.webp', name: "Birlik Galvaniz" },
  { src: '/img/18.webp', name: "Filiz" },
  { src: '/img/19.webp', name: "Akçansa Çimento" },
];

const title = `AR-KAR İnşaat Samsun | ${EXPERIENCE_YEARS} Yıllık Güvenilir İnşaat, Tarım ve PVC Firması | Çarşamba`;
const description = `AR-KAR İnşaat olarak Samsun Çarşamba'da ${EXPERIENCE_YEARS} yıldır güvenilir hizmet veriyoruz. Konut inşaat projeleri, anahtar teslim inşaat, PVC kapı-pencere, tarım ürünleri ve zirai ilaç satışı ile kaliteli hizmet sunuyoruz.`;
const canonical = "https://ar-kar.com/";
const ogImage = "https://ar-kar.com/img/og-default.webp";

---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  
  activePage="index"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={`{
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "AR-KAR GIDA TARIM ÜRÜNLERİ VE TAŞIMACILIK TİCARET LİMİTED ŞİRKETİ",
        "alternateName": "AR-KAR İnşaat",
        "url": "https://ar-kar.com",
        "logo": "https://ar-kar.com/img/logo.webp",
        "description": "Samsun Çarşamba'da ${EXPERIENCE_YEARS} yıldır güvenilir hizmet veren AR-KAR İnşaat. Konut inşaat projeleri, anahtar teslim inşaat, PVC kapı-pencere, tarım ürünleri ve zirai ilaç satışı.",
        "foundingDate": "1987",
        "address": [
            {
                "@type": "PostalAddress",
                "streetAddress": "Orta Mah. Dr. Orhan Atılgan Cad. No:24/A",
                "addressLocality": "Çarşamba",
                "addressRegion": "Samsun",
                "addressCountry": "TR",
                "name": "Şube"
            },
            {
                "@type": "PostalAddress",
                "streetAddress": "Aşağı Kavacık Mah. No:46/A",
                "addressLocality": "Çarşamba",
                "addressRegion": "Samsun",
                "addressCountry": "TR",
                "name": "Merkez"
            }
        ],
        "telephone": ["+90 362 846 03 93", "+90 362 834 18 48"],
        "email": "arkargida@gmail.com",
        "sameAs": [
            "https://www.instagram.com/arkarltd",
            "https://www.facebook.com/arkarltd/"
        ],
        "serviceArea": {
            "@type": "Place",
            "name": "Samsun, Türkiye"
        },
        "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "AR-KAR Hizmetleri",
            "itemListElement": [
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Service",
                        "name": "İnşaat Projeleri",
                        "description": "Modern ve kaliteli konut projeleri ile hayalinizdeki evi gerçeğe dönüştürüyoruz."
                    }
                },
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Service",
                        "name": "Anahtar Teslim İnşaat",
                        "description": "A'dan Z'ye tüm inşaat süreçlerini yönetir, size sadece anahtar teslim ederiz."
                    }
                },
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Service",
                        "name": "PVC Kapı ve Pencere Sistemleri",
                        "description": "Enerji tasarruflu ve dayanıklı PVC kapı pencere sistemleri ile konforunuzu artırın."
                    }
                },
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Service",
                        "name": "Tarım Ürünleri Alım Satımı",
                        "description": "Kaliteli tarım ürünleri alım satımı ile çiftçilerimizin yanındayız."
                    }
                },
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Service",
                        "name": "Zirai İlaç, Gübre ve Tohum",
                        "description": "Yüksek verimli tarım için kaliteli zirai ilaç, gübre ve tohum ürünleri sunuyoruz."
                    }
                },
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Service",
                        "name": "Mimari Proje Hizmetleri",
                        "description": "Profesyonel mimari projeler, ruhsat işlemleri ve teknik çizim hizmetleri sunuyoruz."
                    }
                }
            ]
        }
    }`} />
    <script is:inline type="application/ld+json" set:html={`{
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "AR-KAR İnşaat",
        "image": "https://ar-kar.com/img/logo.webp",
        "@id": "https://ar-kar.com",
        "url": "https://ar-kar.com",
        "telephone": "+90 362 834 18 48",
        "priceRange": "$$",
        "address": {
            "@type": "PostalAddress",
            "streetAddress": "Orta Mah. Dr. Orhan Atılgan Cad. No:24/A",
            "addressLocality": "Çarşamba",
            "addressRegion": "Samsun",
            "postalCode": "55500",
            "addressCountry": "TR"
        },
        "geo": {
            "@type": "GeoCoordinates",
            "latitude": 41.1986,
            "longitude": 36.7153
        },
        "openingHoursSpecification": {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": [
                "Monday",
                "Tuesday",
                "Wednesday",
                "Thursday",
                "Friday",
                "Saturday"
            ],
            "opens": "08:00",
            "closes": "18:00"
        },
        "sameAs": [
            "https://www.facebook.com/arkarltd/",
            "https://www.instagram.com/arkarltd"
        ]
    }`} />
    <!-- NOT: Buradan "aggregateRating" (4.8 / 127 değerlendirme) kaldırıldı.
         Sitede tek bir müşteri yorumu yoktu; Google'ın yapısal veri
         politikası, sayfada görünmeyen ve firmanın kendi kendine verdiği
         puanları açıkça yasaklar. Bu işaretleme "Spammy structured markup"
         manuel işlemi ve tüm zengin sonuçların kaybı riskini taşıyordu.
         Gerçek yorumlar toplanıp sayfada gösterildiğinde, o yorumlara
         dayanan bir aggregateRating tekrar eklenebilir. -->
  </Fragment>

  <!-- Hero Carousel Start -->
    <div class="hero-full">
            <div class="bento-tile bento-tile--hero p-0">
                <div id="header-carousel" class="carousel slide carousel-fade h-100" data-bs-ride="carousel" data-bs-interval="5000">
                    <div class="carousel-indicators">
                        <button type="button" data-bs-target="#header-carousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                        <button type="button" data-bs-target="#header-carousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
                        <button type="button" data-bs-target="#header-carousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
                    </div>
                    <div class="carousel-inner h-100">
                        <div class="carousel-item active h-100">
                            <img src="/img/carousel-1.webp" alt="AR-KAR İnşaat - Samsun Çarşamba Bölgesi" loading="eager">
                            <div class="bento-tile__content">
                                <span class="bento-tile__eyebrow">Samsun · Çarşamba</span>
                                <p class="bento-tile__title">AR-KAR — Samsun Çarşamba'da {EXPERIENCE_YEARS} Yıllık Güvenilir İnşaat ve Tarım</p>
                                <a href="#contact" class="btn btn-primary">Bize Ulaşın</a>
                            </div>
                        </div>
                        <div class="carousel-item h-100">
                            <img src="/img/carousel-2.webp" alt="AR-KAR İnşaat - Aş.Kavacık Merkez Ofisimiz" loading="lazy">
                            <div class="bento-tile__content">
                                <span class="bento-tile__eyebrow">Aş. Kavacık · Merkez Ofisimiz</span>
                                <p class="bento-tile__title">Aş.Kavacık'da Başlayan Kalite, Her Projede Yanınızda</p>
                                <a href="#merkez" class="btn btn-primary">Merkezimiz</a>
                            </div>
                        </div>
                        <div class="carousel-item h-100">
                            <img src="/img/carousel-3.webp" alt="AR-KAR İnşaat - Çarşamba Şubemiz" loading="lazy">
                            <div class="bento-tile__content">
                                <span class="bento-tile__eyebrow">Çarşamba Şubemiz</span>
                                <p class="bento-tile__title">Projelerin Güvencesi, Ustaların Tercihi</p>
                                <a href="#sube" class="btn btn-primary">Şubemiz</a>
                            </div>
                        </div>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#header-carousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#header-carousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>
    </div>
    <!-- Hero Carousel End -->

    <!-- About Start -->
    <div class="container-fluid py-6 px-5" id="about">
        <div class="row g-5">
            <div class="col-lg-7">
                <SectionHeader as="h1" align="left" accent={`${EXPERIENCE_YEARS} Yıllık`} title="Güven ve Tecrübe" />
                <p class="lead fw-semibold text-body mb-3">Faaliyet gösterdiğimiz tüm sektörlerde başarımızı kanıtlayarak
                    müşteri memnuniyeti ve sektör takdirini kazanıyoruz.</p>
                <p>{COMPANY.displayName} olarak 10'dan fazla sektörde, {EXPERIENCE_YEARS} yılı
                    aşkın süredir bilgi, birikim ve tecrübemizle Samsun'un Çarşamba ilçesinde hizmet vermekteyiz. İlk
                    olarak Nurettin Arabacı tarafından Arabacı Ticaret olarak kurulan firmamız, 1996 yılında Ar-kar
                    ismiyle limited şirketi olmuş ve kurumsallaşmaya başlamıştır.</p>
            </div>

            <div class="col-lg-5 pb-5 d-flex align-items-center justify-content-center" style="min-height: 400px;">
                <img class="img-fluid w-100 h-auto rounded" src="/img/about.webp"
                    alt="AR-KAR İnşaat Hakkımızda - {EXPERIENCE_YEARS} Yıllık Tecrübe"
                    style="object-fit: contain; border: none; max-height: 380px;" loading="lazy">
            </div>
        </div>
    </div>
    <!-- About End -->



    <!-- Projects Start -->
    <div class="container-fluid bg-light py-6 px-5" id="projects">
        <SectionHeader accent="İnşaat" title="Projelerimiz" lede={`${EXPERIENCE_YEARS} yıllık tecrübemizle hayata geçirdiğimiz kaliteli konut projeleri`} />
        <div class="row g-4">
            {homeProjects.map((project) => {
                const slug = project.id.replace(/\/index$/, '');
                const cover = project.data.coverImage || '/img/about.webp';
                const overlayText = [project.data.specs, project.data.description].filter(Boolean).join('. ');
                return (
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="project-item position-relative overflow-hidden rounded">
                            <img class="img-fluid w-100" src={cover} alt={`${project.data.title} - AR-KAR İnşaat`}
                                style="height: 300px; object-fit: contain; background: var(--surface-alt);" loading="lazy">
                            <div class="project-overlay position-absolute top-0 start-0 w-100 h-100 d-flex flex-column justify-content-center align-items-center text-white text-center p-4"
                                style="background: rgba(231, 30, 36, 0.8); opacity: 0; transition: all 0.3s;">
                                <h4 class="text-white mb-3">{project.data.title}</h4>
                                {overlayText && <p class="mb-3">{overlayText}</p>}
                                <a href={`/projeler/${slug}`} class="btn btn-light">Detayları Gör</a>
                            </div>
                        </div>
                    </div>
                );
            })}
        </div>
        <div class="text-center mt-5">
            <a href="/projeler" class="btn btn-primary btn-lg px-5 py-3">
                <i class="fa fa-building me-2"></i>Tüm Projelerimizi Görüntüle
            </a>
        </div>
    </div>
    <!-- Projects End -->


    <!-- Dealerships Start -->
    <section class="container-fluid py-6 px-0" id="dealerships" aria-labelledby="dealerships-title">
        <div class="px-3 px-md-5">
            {/* Marka sayısı BİLEREK yazılmıyor — panelden yeni bayilik
                eklendiğinde/çıkarıldığında burası elle güncellenmesi
                gereken bir sayı bırakmasın. */}
            <SectionHeader accent="Güvenilir" title="İş Ortaklarımız" id="dealerships-title"
                lede="Bayiliğini yaptığımız ve birlikte çalıştığımız güvenilir markalar" />
        </div>

        {/* Kayan marka şeridi. Eskiden Bootstrap carousel'i tek logo
            gösterip 5 saniyede bir değiştiriyordu (tamamını görmek
            ~95 saniye sürüyordu); statik ızgara ise tamamını anında
            gösteriyordu ama "kayan" hissi istenmiyordu. Bu ikisi arası:
            tüm logolar aynı anda görünür VE şerit kendiliğinden akar.
            Liste CSS animasyonuyla kesintisiz döngü için ikiye
            katlanmıştır; ikinci kopya ekran okuyuculardan gizlidir. */}
        <div class="partner-marquee">
            <div class="partner-marquee__rail">
                <ul class="partner-marquee__track">
                    {PARTNERS.map((partner) => (
                        <li class="partner-marquee__item">
                            <img
                                src={partner.src}
                                alt={partner.name + " — AR-KAR iş ortağı"}
                                title={partner.name}
                                loading="lazy"
                                decoding="async"
                                width="200"
                                height="120"
                            />
                        </li>
                    ))}
                </ul>
                <ul class="partner-marquee__track" aria-hidden="true">
                    {PARTNERS.map((partner) => (
                        <li class="partner-marquee__item">
                            <img
                                src={partner.src}
                                alt=""
                                loading="lazy"
                                decoding="async"
                                width="200"
                                height="120"
                            />
                        </li>
                    ))}
                </ul>
            </div>
        </div>
    </section>




    <!-- Services Start -->
    <div class="container-fluid bg-light py-6 px-5" id="service">
        <SectionHeader accent="AR-KAR Güvencesiyle" title="Sağladığımız Hizmetler" />

        <div class="services-bento">
            <a href="/projeler" class="bento-tile bento-tile--service">
                <div class="service-icon-badge"><i class="fa fa-building"></i></div>
                <h3>İnşaat Projeleri</h3>
                <p>Modern ve kaliteli konut projeleri ile hayalinizdeki evi gerçeğe dönüştürüyoruz.</p>
                <span class="btn btn-sm text-primary">Detaylı Bilgi <i class="fa fa-arrow-right"></i></span>
            </a>

            <a href="/muteahhitlik" class="bento-tile bento-tile--service">
                <div class="service-icon-badge"><i class="fa fa-home"></i></div>
                <h3>Anahtar Teslim İnşaat</h3>
                <p>A'dan Z'ye tüm inşaat süreçlerini yönetir, size sadece anahtar teslim ederiz.</p>
                <span class="btn btn-sm text-primary">Detaylı Bilgi <i class="fa fa-arrow-right"></i></span>
            </a>

            <a href="/insaat" class="bento-tile bento-tile--service">
                <div class="service-icon-badge"><i class="fa fa-tools"></i></div>
                <h3>Hırdavat &amp; İnşaat Malzemeleri</h3>
                <p>Kaliteli inşaat malzemeleri ve hırdavat ürünleri ile projelerinizi destekliyoruz.</p>
                <span class="btn btn-sm text-primary">Detaylı Bilgi <i class="fa fa-arrow-right"></i></span>
            </a>

            <a href="/mimar" class="bento-tile bento-tile--service">
                <div class="service-icon-badge"><i class="fa fa-drafting-compass"></i></div>
                <h3>Mimari Proje Hizmetleri</h3>
                <p>Profesyonel mimari projeler, ruhsat işlemleri ve teknik çizim hizmetleri sunuyoruz.</p>
                <span class="btn btn-sm text-primary">Detaylı Bilgi <i class="fa fa-arrow-right"></i></span>
            </a>

            <a href="/pvc" class="bento-tile bento-tile--service">
                <div class="service-icon-badge"><i class="fa fa-palette"></i></div>
                <h3>PVC Kapı ve Pencere Sistemleri</h3>
                <p>Enerji tasarruflu ve dayanıklı PVC kapı pencere sistemleri ile konforunuzu artırın.</p>
                <span class="btn btn-sm text-primary">Detaylı Bilgi <i class="fa fa-arrow-right"></i></span>
            </a>

            <a href="/tarim" class="bento-tile bento-tile--service">
                <div class="service-icon-badge"><i class="fa fa-seedling"></i></div>
                <h3>Tarım Ürünleri Alım Satımı</h3>
                <p>Kaliteli tarım ürünleri alım satımı ile çiftçilerimizin yanındayız.</p>
                <span class="btn btn-sm text-primary">Detaylı Bilgi <i class="fa fa-arrow-right"></i></span>
            </a>

            <a href="/ziraat" class="bento-tile bento-tile--service">
                <div class="service-icon-badge"><i class="fa fa-leaf"></i></div>
                <h3>Zirai Ürünler ve Danışmanlık</h3>
                <p>Yüksek verimli tarım için kaliteli zirai ilaç, gübre ve tohum ürünleri sunuyoruz.</p>
                <span class="btn btn-sm text-primary">Detaylı Bilgi <i class="fa fa-arrow-right"></i></span>
            </a>
        </div>
    </div>
    <!-- Services End -->



    <!-- Contact Start -->
    <div class="container-fluid py-6 px-5" id="contact">
        <SectionHeader accent="İletişim" title="Bilgilerimiz" />
        <div class="row g-4">
            <!-- Şube -->
            <div class="col-12 col-lg-6" id="sube">
                <Card padded={false} hoverable={false} class="h-100">
                    <div class="card-surface__body h-100 d-flex flex-column">
                        <h3 class="mb-3"><i class="fa fa-map-marker-alt text-primary me-2" aria-hidden="true"></i>{COMPANY.branches[0].name}</h3>
                        <div class="mb-2">
                            <strong><i class="fa fa-map-marker-alt text-primary me-2" aria-hidden="true"></i>Adres:</strong>
                            <span>{COMPANY.branches[0].street} {COMPANY.branches[0].district}, {COMPANY.branches[0].city}</span>
                        </div>
                        <div class="mb-2">
                            <strong><i class="fa fa-phone-alt text-primary me-2" aria-hidden="true"></i>Telefon:</strong>
                            <span>{COMPANY.branches[0].phone}</span>
                        </div>
                        <div class="mb-2">
                            <strong><i class="fa fa-mobile-alt text-primary me-2" aria-hidden="true"></i>Mobil:</strong>
                            <span>{COMPANY.branches[0].mobile}</span>
                        </div>
                        <div class="mb-2">
                            <strong><i class="fa fa-envelope text-primary me-2" aria-hidden="true"></i>E-posta:</strong>
                            <span>{COMPANY.email}</span>
                        </div>
                        <div class="mb-2">
                            <strong><i class="fa fa-clock text-primary me-2" aria-hidden="true"></i>Çalışma Saatleri:</strong>
                            <span>{COMPANY.openingHours.days}: {COMPANY.openingHours.opens} - {COMPANY.openingHours.closes}</span>
                        </div>
                        <div class="mt-3 flex-grow-1 d-flex align-items-end">
                            <iframe class="w-100 rounded" height="200"
                                src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d772.468571026306!2d36.73518574680688!3d41.20190120018642!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x408805eef4150237%3A0xacad6d76d6d10c25!2zQVItS0FSIMSwTsWeQUFULCBHSURBLCBUQVJJTSDDnFLDnE5MRVLEsCBWRSBUQcWeLiBUxLBDLiBMVEQuIMWeVMSw!5e0!3m2!1str!2str!4v1752059976203!5m2!1str!2str"
                                frameborder="0" style="border:0;" allowfullscreen="" loading="lazy"
                                title={`${COMPANY.branches[0].name} konum haritası`}></iframe>
                        </div>
