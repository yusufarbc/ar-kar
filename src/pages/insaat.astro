                                </div>
                                <p class="material-description">
                                    Nervürlü inşaat demiri, Hasır Demir, İnce Demir, Bağ Teli, Takviye Teli ve Çivi türleri.
                                </p>
                                <div class="material-features">
                                    <span class="feature-tag">Demir</span>
                                    <span class="feature-tag">İnce Demir</span>
                                    <span class="feature-tag">Hasır Demir</span>
                                    <span class="feature-tag">Tel</span>
                                    <span class="feature-tag">çivi</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- İNCE İNŞAAT MALZEMELERİ -->
            <div class="category-section mb-5">
                <div class="text-center mb-4">
                    <h2 class="display-6 text-uppercase mb-3">
                        <i class="fa fa-palette text-primary me-3"></i>
