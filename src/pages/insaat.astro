        as="h1"
        id="materials-title"
        accent="En Kaliteli"
        title="İnşaat Malzemeleri"
        lede={`AR-KAR İnşaat olarak, ${EXPERIENCE_YEARS} yıllık sektör deneyimimizle Samsun Çarşamba'da en kaliteli inşaat malzemelerini sizlere sunuyoruz. Kaba inşaattan ince yapı malzemelerine, hırdavattan yalıtım ürünlerine kadar geniş ürün yelpazemizle her türlü inşaat projenizi destekliyoruz.`}
      />

      {MATERIAL_CATEGORIES.map((category, i) => (
        <div class={`category-section ${i > 0 ? 'mt-5' : ''} mb-5`}>
          <SectionHeader as="h2" accent={category.accent} title={category.title} lede={category.lede} />
          <div class="row g-4">
            {category.items.map((item) => (
              <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 col-12">
