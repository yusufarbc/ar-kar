const title = 'Hırdavat & İnşaat Malzemeleri | AR-KAR İnşaat Samsun | Boya, Çimento, Demir Çelik';
const description = `AR-KAR İnşaat Malzemeleri: Samsun Çarşamba'da kaba inşaat, ince inşaat, hırdavat, elektrik, tesisat ve yalıtım malzemeleri. Çimento, gaz beton, seramik, kalebodur, PPRC boru ve daha fazlası. ${EXPERIENCE_YEARS} yıllık deneyimle kaliteli hizmet.`;
const canonical = 'https://ar-kar.com/insaat';
const ogImage = 'https://ar-kar.com/img/boya.webp';
---

<BaseLayout title={title} description={description} canonical={canonical} ogImage={ogImage} activePage="insaat">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={`{
        "@context": "https://schema.org",
        "@type": "WebPage",
        "name": "Hırdavat & İnşaat Malzemeleri | AR-KAR İnşaat",
        "description": "AR-KAR İnşaat Malzemeleri: Samsun Çarşamba'da en kaliteli boya, çimento, demir-çelik, elektrik, tesisat, yalıtım ve kaplama malzemeleri. ${EXPERIENCE_YEARS} yıllık deneyimle güvenilir hizmet.",
        "url": "https://ar-kar.com/insaat",
        "mainEntity": {
            "@type": "LocalBusiness",
            "@id": "https://ar-kar.com/#organization",
            "name": "AR-KAR GIDA TARIM ÜRÜNLERİ VE TAŞIMACILIK TİCARET LİMİTED ŞİRKETİ",
            "alternateName": "AR-KAR İnşaat",
            "url": "https://ar-kar.com",
            "telephone": "+90 544 439 33 33",
            "email": "arkargida@gmail.com",
            "address": {
                "@type": "PostalAddress",
                "addressLocality": "Çarşamba",
                "addressRegion": "Samsun",
                "addressCountry": "TR"
            },
            "geo": {
                "@type": "GeoCoordinates",
                "latitude": 41.1986,
                "longitude": 36.7153
            },
            "openingHours": "Mo-Sa 08:00-20:00",
            "areaServed": {
                "@type": "GeoCircle",
