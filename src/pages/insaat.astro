                  <CardMedia src={item.img} alt={item.alt} aspectRatio={item.ratio}>
                    <Badge slot="badge" label={item.badgeLabel} icon={item.badgeIcon} />
                  </CardMedia>
                  <div class="card-surface__body flex-grow-1 d-flex flex-column">
                    <h3 class="h5 mb-2">{item.title}</h3>
                    {item.brands && (
                      <p class="small fw-semibold text-primary mb-2">
