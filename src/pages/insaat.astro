                        <div class="material-card card h-100 shadow-sm rounded-3">
                            <div class="card-img-container">
                                <img src="/img/duvar.webp" alt="Tuğla, Kiremit, Gaz Beton - AR-KAR İnşaat" class="card-img-top" loading="lazy">
                                <div class="material-category-badge">
                                    <i class="fa fa-th-large me-1"></i>Duvar
                                </div>
                            </div>
                            <div class="material-card-content">
                                <h3 class="material-card-title">Duvar Örgü Grubu</h3>
                                <div class="material-brand-info">
                                    <i class="fa fa-star text-primary me-1"></i>
                                    Osmancık, Boyabat, Bims, YTONG
                                </div>
                                <p class="material-description">
                                    Tuğla, briket, gaz beton ve baca tuğlası türleri.
                                </p>
                                <div class="material-features">
                                    <span class="feature-tag">Tuğla</span>
                                    <span class="feature-tag">Briket</span>
                                    <span class="feature-tag">Gaz Beton</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- İnşaat Demiri, Hasır, Tel -->
                    <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 col-12">
                        <div class="material-card card h-100 shadow-sm rounded-3">
                            <div class="card-img-container">
                                <img src="/img/demir.webp" alt="İnşaat Demiri, Hasır, Tel - AR-KAR İnşaat" class="card-img-top" loading="lazy">
                                <div class="material-category-badge">
                                    <i class="fa fa-industry me-1"></i>Donatı
                                </div>
                            </div>
                            <div class="material-card-content">
                                <h3 class="material-card-title">Demir Grubu</h3>
                                <div class="material-brand-info">
                                    <i class="fa fa-star text-primary me-1"></i>
