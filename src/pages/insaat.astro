---
import { EXPERIENCE_YEARS } from '../lib/company';
import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Hırdavat & İnşaat Malzemeleri | AR-KAR İnşaat Samsun | Boya, Çimento, Demir Çelik";
const description = `AR-KAR İnşaat Malzemeleri: Samsun Çarşamba'da kaba inşaat, ince inşaat, hırdavat, elektrik, tesisat ve yalıtım malzemeleri. Çimento, gaz beton, seramik, kalebodur, PPRC boru ve daha fazlası. ${EXPERIENCE_YEARS} yıllık deneyimle kaliteli hizmet.`;
const canonical = "https://ar-kar.com/insaat";
const ogImage = "https://ar-kar.com/img/boya.webp";

---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  
  activePage="insaat"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={`{
        "@context": "https://schema.org",
        "@type": "WebPage",
        "name": "Hırdavat & İnşaat Malzemeleri | AR-KAR İnşaat",
        "description": "AR-KAR İnşaat Malzemeleri: Samsun Çarşamba'da en kaliteli boya, çimento, demir-çelik, elektrik, tesisat, yalıtım ve kaplama malzemeleri. ${EXPERIENCE_YEARS} yıllık deneyimle güvenilir hizmet.",
        "url": "https://ar-kar.com/insaat",
        "mainEntity": {
            "@type": "LocalBusiness",
            "@id": "https://ar-kar.com/#organization",
            "name": "AR-KAR GIDA TARIM ÜRÜNLERİ VE TAŞIMACILIK TİCARET LİMİTED ŞİRKETİ",
            "alternateName": "AR-KAR İnşaat",
            "url": "https://ar-kar.com",
            "telephone": "+90 544 439 33 33",
            "email": "arkargida@gmail.com",
            "address": {
                "@type": "PostalAddress",
                "addressLocality": "Çarşamba",
                "addressRegion": "Samsun",
                "addressCountry": "TR"
            },
            "geo": {
                "@type": "GeoCoordinates",
                "latitude": 41.1986,
                "longitude": 36.7153
            },
            "openingHours": "Mo-Sa 08:00-18:00",
            "areaServed": {
                "@type": "GeoCircle",
                "geoMidpoint": {
                    "@type": "GeoCoordinates",
                    "latitude": 41.1986,
                    "longitude": 36.7153
                },
                "geoRadius": "50000"
            }
        },
        "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "AR-KAR İnşaat Malzemeleri Kataloğu",
            "itemListElement": [
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Product",
                        "name": "Kaba İnşaat Malzemeleri",
                        "description": "Çimento, kireç, alçı, kum, çakıl, mıcır, tuğla, briket, gaz beton (YTONG), inşaat demiri, hasır çelik ve tel.",
                        "category": "İnşaat Malzemesi",
                        "brand": ["Akçansa", "Göltaş", "YTONG", "İçdaş"]
                    }
                },
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Product",
                        "name": "İnce İnşaat Malzemeleri",
                        "description": "Kalebodur, fayans, seramik, klozet, banyo dolapları, duşakabin, granit, mermer, parke, alçıpan ürünleri, boya ve yapıştırıcılar.",
                        "category": "İnşaat Malzemesi",
                        "brand": ["Kalebodur", "Vitra", "Kale", "Rigips"]
                    }
                },
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Product",
                        "name": "Hırdavat Malzemeleri",
                        "description": "Vida, dübel, çivi, cıvata, el aletleri (çekiç, pense, tornavida), kilit, menteşe, kapı kolu, rulo, fırça.",
                        "category": "İnşaat Malzemesi",
                        "brand": ["Bosch", "Makita", "Stanley", "Fischer"]
                    }
                },
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Product",
                        "name": "Elektrik Malzemeleri",
                        "description": "Kablo, priz, anahtar, sigorta, panolar, LED ampul, armatür, aydınlatma, tesisat borusu, buat, kablo kanalı.",
                        "category": "İnşaat Malzemesi",
                        "brand": ["Schneider", "Legrand", "Viko", "Philips"]
                    }
                },
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Product",
