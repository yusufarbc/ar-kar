                                    Çanakkale, İda, Termal, Etili, Duratiles, Rino
                                </div>
                                <p class="material-description">
                                    Seramik, Granit ve Fayans türleri.
                                </p>
                                <div class="material-features">
                                    <span class="feature-tag">Fayans</span>
                                    <span class="feature-tag">Seramik</span>
                                    <span class="feature-tag">Granit</span>
                                    <span class="feature-tag">Mermer</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Bölme ve Yüzey Malzemeleri -->
                    <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 col-12">
                        <div class="material-card card h-100 shadow-sm rounded-3">
                            <div class="card-img-container">
                                <img src="/img/alcipan.webp" alt="Bölme ve Yüzey Malzemeleri - AR-KAR İnşaat" class="card-img-top" loading="lazy">
