                    "@type": "GeoCoordinates",
                    "latitude": 41.1986,
                    "longitude": 36.7153
                },
                "geoRadius": "50000"
            }
        },
        "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "AR-KAR İnşaat Malzemeleri Kataloğu",
            "itemListElement": [
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Product",
                        "name": "Kaba İnşaat Malzemeleri",
                        "description": "Çimento, kireç, alçı, kum, çakıl, mıcır, tuğla, briket, gaz beton (YTONG), inşaat demiri, hasır çelik ve tel.",
                        "category": "İnşaat Malzemesi",
                        "brand": ["Akçansa", "Göltaş", "YTONG", "İçdaş"]
                    }
                },
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Product",
                        "name": "İnce İnşaat Malzemeleri",
                        "description": "Kalebodur, fayans, seramik, klozet, banyo dolapları, duşakabin, granit, mermer, parke, alçıpan ürünleri, boya ve yapıştırıcılar.",
