    <style is:inline set:html={`/* Lazy Loading Optimization - Bulanıklık ve sislilik efekti tamamen kaldırıldı */
        img[loading="lazy"] {
            opacity: 1;
            filter: none;
            transition: none;
        }
        
        /* Preload Critical Images */
        .logo-img {
            font-display: swap;
        }
        
        /* Performance Optimizations */
        .material-card-img {
            will-change: transform;
            transform: translateZ(0);
        }
        
        /* Accessibility Improvements */
        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }
        
        /* Focus improvements */
        .material-card:focus-within,
        .contact-card:focus-within {
            outline: 2px solid var(--primary);
            outline-offset: 2px;
        }
        
        /* Reduced Motion Support */
        @media (prefers-reduced-motion: reduce) {
            .material-card,
            .material-card img,
            .material-card-content {
                transition: none !important;
                animation: none !important;
            }
        }`} />
    <style is:inline set:html={`/* Material Cards */
        .material-card{transition:all .3s ease;border:0;background: var(--surface);overflow:hidden;height:100%}
        .material-card:hover{transform:translateY(-10px);box-shadow:0 15px 35px rgba(0,0,0,.1)}
        .material-card .card-img-container{position:relative;overflow:hidden;height:400px;aspect-ratio:1/1;background: var(--surface-alt);display:flex;align-items:center;justify-content:center}
        .material-card .card-img-container img{width:100%;height:100%;object-fit:cover;transition:transform .3s ease}
        .material-card:hover .card-img-container img{transform:scale(1.05)}
        .material-category-badge{position:absolute;top:15px;left:15px;background:var(--primary);color:#fff;padding:8px 12px;border-radius:20px;font-size:.85rem;font-weight:600;text-transform:uppercase;
z-index:2}
        .material-card-content{padding:25px;height:auto;display:flex;flex-direction:column}
        .material-card-title{font-size:1.25rem;font-weight:700;color: var(--ink-900);margin-bottom:10px;text-transform:uppercase;line-height:1.3}
        .material-brand-info{color:var(--primary);font-weight:600;margin-bottom:12px;font-size:.95rem}
        .material-description{color: var(--ink-500);font-size:.9rem;line-height:1.5;margin-bottom:15px;flex-grow:1}
        .material-features{display:flex;flex-wrap:wrap;gap:8px;margin-top:auto}
        .feature-tag{background: var(--surface-alt);color:var(--primary);padding:4px 10px;border-radius:12px;font-size:.8rem;border:1px solid var(--ink-100)}
        .materials-section{background:linear-gradient(135deg, var(--surface-alt) 0%, var(--surface) 100%);position:relative}
        .materials-section::before{content:'';position:absolute;top:0;left:0;right:0;height:100px;background:linear-gradient(to bottom,rgba(231,30,36,.05),transparent)}
        .section-header{position:relative;z-index:2}
        .section-title{font-size:2.5rem;font-weight:700;color: var(--ink-900);margin-bottom:20px}
        .section-subtitle{font-size:1.1rem;color: var(--ink-500);line-height:1.6;max-width:800px;margin:0 auto}
        .section-divider{position:relative;margin:60px 0;text-align:center}
        .section-divider::before{content:'';position:absolute;top:50%;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent 0%,var(--primary) 20%,var(--primary) 80%,transparent 100%);transform:translateY(-50%)}
        .section-divider-content{display:inline-block;background: var(--surface);padding:0 30px;color:var(--primary);font-weight:600;font-size:1.1rem}
        .category-section{position:relative;padding:40px 0}
        .category-section:not(:first-child){border-top:3px solid var(--ink-100);margin-top:50px;position:relative}
        .category-section:not(:first-child)::before{content:'';position:absolute;top:-1.5px;left:50%;transform:translateX(-50%);width:100px;height:3px;background:var(--primary)}
        @media(max-width:768px){.material-card .card-img-container{height:320px}.material-card-content{padding:20px}.material-card-title{font-size:1.1rem}.section-title{font-size:2rem}.section-subtitle{font-size:1rem}.section-divider{margin:40px 0}.section-divider-content{padding:0 20px;font-size:1rem}.category-section{padding:30px 0}.category-section:not(:first-child){margin-top:40px}.category-section:not(:first-child)::before{width:80px}.footer .navbar-brand img{max-height:60px !important;width:auto}}
        @media(max-width:576px){.material-card .card-img-container{height:280px}.material-card-content{padding:15px}.material-card-title{font-size:1rem}.section-title{font-size:1.8rem}.material-features{gap:5px}.feature-tag{font-size:.75rem;padding:3px 8px}.section-divider{margin:30px 0}.section-divider-content{padding:0 15px;font-size:.9rem}.category-section{padding:25px 0}.category-section:not(:first-child){margin-top:30px}.category-section:not(:first-child)::before{width:60px}}
        .material-card{opacity:0;animation:fadeInUp .6s ease forwards}
        .material-card:nth-child(1){animation-delay:.1s}.material-card:nth-child(2){animation-delay:.2s}.material-card:nth-child(3){animation-delay:.3s}.material-card:nth-child(4){animation-delay:.4s}.material-card:nth-child(5){animation-delay:.5s}.material-card:nth-child(6){animation-delay:.6s}.material-card:nth-child(7){animation-delay:.7s}.material-card:nth-child(8){animation-delay:.8s}
        @keyframes fadeInUp{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}
        .materials-container{padding:15px}
        @media(min-width:768px){.materials-container{padding:40px}}
        @media(min-width:1200px){.materials-container{padding:60px}}
        
        /* WhatsApp floating button */
        .whatsapp-float {
            position: fixed;
            width: 60px;
            height: 60px;
            bottom: 20px;
            right: 20px;
            background-color: #25d366;
            color: white;
            border-radius: 50px;
            text-align: center;
            font-size: 30px;
            box-shadow: 2px 2px 3px #999;
            z-index: 1000;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
        }
        
        .whatsapp-float:hover {
            background-color: #20c55e;
            color: white;
            transform: scale(1.1);
            text-decoration: none;
        }
        
        @media (max-width: 768px) {
            .whatsapp-float {
                width: 55px;
                height: 55px;
                bottom: 15px;
                right: 15px;
                font-size: 25px;
            }
        }`} />
  </Fragment>

  <PageHeader active="Hırdavat & İnşaat Malzemeleri" />

    <!-- Portfolio Start -->
    <section class="materials-section py-6" aria-labelledby="materials-title">
        <div class="container-fluid materials-container">
            <div class="section-header text-center mx-auto mb-5" style="max-width: 800px;">
                <h1 id="materials-title" class="section-title">
                    <span class="text-primary">En Kaliteli</span> İnşaat Malzemeleri
                </h1>
                <p class="section-subtitle">
                    AR-KAR İnşaat olarak, {EXPERIENCE_YEARS} yıllık sektör deneyimimizle Samsun Çarşamba'da en kaliteli inşaat malzemelerini sizlere sunuyoruz. 
                    Kaba inşaattan ince yapı malzemelerine, hırdavattan yalıtım ürünlerine kadar geniş ürün yelpazemizle her türlü inşaat projenizi destekliyoruz.
                </p>
            </div>

 

            <!-- KABA İNŞAAT MALZEMELERİ -->
            <div class="category-section mb-5">
                <div class="text-center mb-4">
                    <h2 class="display-6 text-uppercase mb-3">
                        <i class="fa fa-cube text-primary me-3"></i>
                        <span class="text-primary">Kaba İnşaat</span> Malzemeleri
                    </h2>
                    <p class="text-muted">Yapının temelini oluşturan kaliteli kaba inşaat malzemeleri</p>
                </div>
                <div class="row g-4">
                    <!-- Çimento, Kireç, Alçı -->
                    <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 col-12">
                        <div class="material-card card h-100 shadow-sm rounded-3">
                            <div class="card-img-container">
                                <img src="/img/cimento.webp" alt="Çimento, Kireç, Alçı - AR-KAR İnşaat" class="card-img-top" width="300" height="280" loading="lazy">
                                <div class="material-category-badge">
                                    <i class="fa fa-cube me-1"></i>Bağlayıcı
                                </div>
                            </div>
                            <div class="material-card-content">
                                <h3 class="material-card-title">Çimento-Kireç-Alçı Grubu</h3>
                                <div class="material-brand-info">
                                    <i class="fa fa-star text-primary me-1"></i>
                                    Kavçim, Oyak, Akçansa, Akkisan, ABS, Knauf
                                </div>
                                <p class="material-description">
                                    Kompoze çimento, sönmüş kireç ve alçı türleri.
                                </p>
                                <div class="material-features">
                                    <span class="feature-tag">Çimento</span>
                                    <span class="feature-tag">Kireç</span>
                                    <span class="feature-tag">Alçı</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Kum, Çakıl, Mıcır -->
                    <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 col-12">
                        <div class="material-card card h-100 shadow-sm rounded-3">
                            <div class="card-img-container">
                                <img src="/img/kum.webp" alt="Kum, Çakıl, Mıcır - AR-KAR İnşaat" class="card-img-top" loading="lazy">
                                <div class="material-category-badge">
                                    <i class="fa fa-mountain me-1"></i>Agrega
                                </div>
                            </div>
                            <div class="material-card-content">
                                <h3 class="material-card-title">Kum-Çakıl-Mıcır Grubu</h3>
                                  <p class="material-description">
                                    İnce Sıva Kumu, İnce Beyaz Kum, Elenmiş Irmak Kumu, Sarı Kavak Kumu, Kırma Çakıl - Irmak Çakılı, Mucur ve Sondaj Mucuru türleri.
                                </p>
                                <div class="material-features">
                                    <span class="feature-tag">Kum</span>
                                    <span class="feature-tag">Çakıl</span>
                                    <span class="feature-tag">Mıcır</span>
                                    <span class="feature-tag">Kırma Taş</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tuğla, Briket, Gaz Beton -->
