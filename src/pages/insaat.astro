---
import { EXPERIENCE_YEARS } from '../lib/company';
import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Card from '../components/ui/Card.astro';
import CardMedia from '../components/ui/CardMedia.astro';
import Badge from '../components/ui/Badge.astro';
import CtaBand from '../components/ui/CtaBand.astro';

interface MaterialItem {
  img: string;
  alt: string;
  /** Görselin gerçek eni/boyu — verilmezse CardMedia varsayılanı (1:1)
   * kullanılır. Kare olmayan birkaç istisna (cimento/kum/boya) için. */
  ratio?: string;
  badgeIcon: string;
  badgeLabel: string;
  title: string;
  brands?: string;
  description: string;
  features: string[];
}
interface MaterialCategory {
  icon: string;
  accent: string;
  title: string;
  lede: string;
  items: MaterialItem[];
}

// Kart markup'ı (görsel + rozet + başlık + özellikler) artık Card/CardMedia/
