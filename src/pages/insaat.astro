                        "description": "PPRC ve PVC borular, dirsek, rakor, vana, batarya, musluk, sifon, lavabo gideri, taharet musluğu.",
                        "category": "İnşaat Malzemesi",
                        "brand": ["Pilsa", "Valplast", "Firat", "Vitra"]
                    }
                },
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Product",
                        "name": "Yalıtım Malzemeleri",
