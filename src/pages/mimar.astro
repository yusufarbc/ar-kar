---
import { EXPERIENCE_YEARS } from '../lib/company';
import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import IconBadge from '../components/ui/IconBadge.astro';

const title = "AR-KAR Mimari Proje Hizmetleri | Ruhsat, Çizim, Tasarım | Samsun Çarşamba";
const description = `AR-KAR İnşaat Mimari Proje Hizmetleri ile Samsun Çarşamba'da profesyonel mimari projeler, yapı ruhsat işlemleri, teknik çizimler, 3D modelleme ve tasarım hizmetleri sunuyoruz. ${EXPERIENCE_YEARS} yıllık tecrübe ile uzman mimar kadromuz hizmetinizde.`;
const canonical = "https://ar-kar.com/mimar";
const ogImage = "https://ar-kar.com/img/mimariproje.webp";
const keywords = "ar-kar mimar, mimari proje, yapı ruhsatı, teknik çizim, proje tasarımı, samsun mimar, çarşamba mimar, yapı denetim, inşaat projeleri, 3D modelleme, autocad çizim, ticari proje, konut projesi";

// Kart/rozet markup'ı artık SectionHeader/IconBadge bileşenlerinden geliyor;
// burada yalnızca VERİ var (bkz. insaat.astro'daki aynı yaklaşım).
const OVERVIEW_FEATURES = [
  {
    icon: 'fa-check-circle',
    title: 'Profesyonel Tasarım',
    description: 'Modern tasarım anlayışı ile işlevsel ve estetik projeler.',
  },
  {
    icon: 'fa-check-circle',
    title: 'Ruhsat İşlemleri',
    description: 'Belediye ve resmi kurumlarda tüm ruhsat işlemleriniz.',
  },
  {
    icon: 'fa-check-circle',
    title: 'AutoCAD Çizimleri',
    description: 'Detaylı ve teknik AutoCAD çizimleri ile hassas projeler.',
  },
  {
    icon: 'fa-check-circle',
    title: '3D Görselleştirme',
    description: 'Projenizi gerçek gibi görebileceğiniz 3D modelleme.',
  },
];

const WHY_US_FEATURES = [
  {
    icon: 'fa-star',
    title: 'Deneyimli Mimar Kadrosu',
    description: 'Alanında uzman mimar ve teknik personel ile hizmet veriyoruz.',
  },
  {
    icon: 'fa-clock',
    title: 'Hızlı Proje Teslimi',
    description: 'Belirlenen süreler içerisinde projelerinizi teslim ederiz.',
  },
  {
    icon: 'fa-handshake',
    title: 'Güvenilir İşbirliği',
    description: `${EXPERIENCE_YEARS} yıllık güven ve kalite anlayışımızla yanınızdayız.`,
  },
  {
    icon: 'fa-hand-holding-usd',
    title: 'Uygun Fiyat',
    description: 'Kaliteli hizmeti en uygun fiyatlarla sunuyoruz.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  keywords={keywords}
  activePage="mimar"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={`{
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "AR-KAR Mimari Proje Hizmetleri",
        "description": "Samsun Çarşamba'da profesyonel mimari proje, yapı ruhsatı, teknik çizim ve tasarım hizmetleri sunuyoruz.",
        "provider": {
            "@type": "Organization",
            "name": "AR-KAR GIDA TARIM ÜRÜNLERİ VE TAŞIMACILIK TİCARET LİMİTED ŞİRKETİ",
            "address": {
                "@type": "PostalAddress",
                "streetAddress": "Orta Mah. Dr. Orhan Atılgan Cad. No:24/A",
                "addressLocality": "Çarşamba",
                "addressRegion": "Samsun",
                "addressCountry": "TR"
            },
            "telephone": "+90 362 846 03 93",
            "email": "arkargida@gmail.com"
        },
        "areaServed": "Samsun, Türkiye",
        "serviceType": "Mimari Proje Hizmetleri",
        "offers": [
            {
                "@type": "Offer",
                "name": "Mimari Proje Tasarımı",
                "description": "Konut ve ticari yapılar için profesyonel mimari proje tasarımı"
            },
            {
                "@type": "Offer",
                "name": "Yapı Ruhsatı İşlemleri",
                "description": "Belediye ve resmi kurumlarda yapı ruhsatı takip işlemleri"
            },
            {
                "@type": "Offer",
                "name": "Teknik Çizim Hizmetleri",
                "description": "AutoCAD ile profesyonel teknik çizim ve plan hazırlama"
            }
        ]
    }`} />
  </Fragment>

  <PageHeader active="Mimari Proje Hizmetleri" parents={[{ label: "Hizmetler", href: "/#service" }]} />

    <!-- Hero Section Start -->
    <div class="container-fluid py-6 px-5" style="background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('/img/projects/tekstilkent.webp'); background-size: cover; background-position: center;">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <h1 class="display-4 text-white mb-4">Profesyonel <span class="text-primary">Mimari Proje</span> Hizmetleri</h1>
                <p class="text-white mb-4 fs-5">{EXPERIENCE_YEARS} yıllık tecrübemizle hayalinizdeki projeleri gerçeğe dönüştürüyoruz. Modern tasarım anlayışı ile işlevsel ve estetik projeler üretiyoruz.</p>
                <div class="row g-3 mt-4">
                    <div class="col-md-4">
                        <div class="bg-primary bg-opacity-75 p-3 rounded">
                            <h5 class="text-white mb-0"><i class="fa fa-home me-2" aria-hidden="true"></i>Konut Projeleri</h5>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="bg-primary bg-opacity-75 p-3 rounded">
                            <h5 class="text-white mb-0"><i class="fa fa-building me-2" aria-hidden="true"></i>Ticari Projeler</h5>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="bg-primary bg-opacity-75 p-3 rounded">
                            <h5 class="text-white mb-0"><i class="fa fa-file-contract me-2" aria-hidden="true"></i>Ruhsat İşlemleri</h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Hero Section End -->

    <!-- Service Overview Start -->
    <div class="container-fluid py-6 px-5">
        <div class="row g-5">
            <div class="col-lg-7">
                <SectionHeader as="h2" align="left" accent="AR-KAR" title="Mimari Proje Hizmetleri" />
                <h4 class="mb-4 text-primary">Hayallerinizi Profesyonel Projelere Dönüştürüyoruz</h4>
                <p class="mb-4">AR-KAR İnşaat olarak, {EXPERIENCE_YEARS} yıllık tecrübemizle mimari proje alanında da uzman hizmet sunuyoruz. Konut, ticari ve endüstriyel yapılar için profesyonel mimari projeler hazırlar, yapı ruhsatı işlemlerinizi takip ederiz.</p>
                <p class="mb-4">Uzman mimar kadromuz ile modern tasarım anlayışını geleneksel Türk mimarisi ile harmanlayarak, işlevsel ve estetik projeler üretiyoruz. Müşterilerimizin ihtiyaçlarını ve bütçelerini göz önünde bulundurarak en uygun çözümleri sunuyoruz.</p>

                <div class="row g-4">
                    {OVERVIEW_FEATURES.map((feature) => (
                      <div class="col-md-6">
                        <div class="d-flex">
                          <div class="flex-shrink-0 me-3"><IconBadge icon={feature.icon} /></div>
                          <div>
                            <h5>{feature.title}</h5>
                            <p class="mb-0">{feature.description}</p>
                          </div>
                        </div>
                      </div>
                    ))}
                </div>
            </div>
            <div class="col-lg-5 pb-4 d-flex align-items-center justify-content-center" style="min-height: 400px;">
                <img class="img-fluid w-100 h-auto rounded" src="/img/mimariproje.webp" style="object-fit: contain; border: none; max-height: 380px;" alt="Mimari Proje Hizmetleri" loading="lazy">
            </div>
        </div>
    </div>
    <!-- Service Overview End -->

    <!-- Why Choose Us Start -->
    <div class="container-fluid bg-light py-6 px-5">
        <div class="row g-5">
            <div class="col-lg-4 pb-4 d-flex align-items-center justify-content-center" style="min-height: 400px;">
                <img class="img-fluid w-100 h-auto rounded" src="/img/mimari.webp" style="object-fit: contain; border: none; max-height: 380px;" alt="AR-KAR Mimari Proje Avantajları" loading="lazy">
            </div>
            <div class="col-lg-8">
                <SectionHeader
                  as="h2"
                  align="left"
                  accent="Neden"
                  title="AR-KAR Mimari Proje?"
                  lede={`${EXPERIENCE_YEARS} yıllık inşaat tecrübemizi mimari proje hizmetlerinde de kullanarak, müşterilerimize en kaliteli ve profesyonel hizmeti sunuyoruz. Deneyimli mimar kadromuz ile hayalinizdeki projeyi gerçeğe dönüştürüyoruz.`}
                />

                <div class="row g-4">
                    {WHY_US_FEATURES.map((feature) => (
                      <div class="col-md-6">
                        <div class="d-flex">
                          <div class="flex-shrink-0 me-3"><IconBadge icon={feature.icon} /></div>
                          <div>
                            <h5>{feature.title}</h5>
                            <p class="mb-0">{feature.description}</p>
                          </div>
                        </div>
                      </div>
                    ))}
                </div>
            </div>
        </div>
    </div>
    <!-- Why Choose Us End -->

    <!-- CTA Section Start -->
    <div class="container-fluid py-6 px-5">
        <div class="cta-band">
            <h3>Hayalinizdeki Projeyi Gerçeğe Dönüştürün</h3>
            <p>AR-KAR İnşaat Mimari Proje bölümü ile iletişime geçin. Uzman mimar kadromuz ile profesyonel projeler hazırlıyor, ruhsat işlemlerinizi takip ediyoruz. Kaliteli tasarım ve güvenilir hizmet için hemen arayın.</p>
            <div class="cta-band__actions">
                <button class="btn btn-light btn-lg px-4" data-bs-toggle="modal" data-bs-target="#contactModal">
                    <i class="fa fa-phone me-2" aria-hidden="true"></i>Hemen Arayın
                </button>
            </div>
        </div>
    </div>
    <!-- CTA Section End -->
</BaseLayout>
