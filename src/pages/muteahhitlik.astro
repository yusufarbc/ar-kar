---
import { EXPERIENCE_YEARS } from '../lib/company';
import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import IconBadge from '../components/ui/IconBadge.astro';
import CtaBand from '../components/ui/CtaBand.astro';

const title = "Anahtar Teslim İnşaat Hizmetleri | AR-KAR İnşaat Samsun | Müteahhitlik Hizmetleri";
const description = `AR-KAR İnşaat anahtar teslim inşaat hizmetleri: Samsun Çarşamba'da villa, konut, fabrika ve ticari bina inşaatı. ${EXPERIENCE_YEARS} yıllık deneyimle profesyonel müteahhitlik hizmetleri.`;
const canonical = "https://ar-kar.com/muteahhitlik";
const ogImage = "https://ar-kar.com/img/anahtarteslim.webp";
const keywords = "anahtar teslim inşaat samsun, müteahhitlik hizmetleri çarşamba, konut inşaat müteahhidi, villa inşaat samsun, anahtar teslim ev yapımı, inşaat müteahhidi çarşamba, ev yapımı";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  keywords={keywords}
  activePage="muteahhitlik"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={`{
        "@context": "https://schema.org",
        "@type": "WebPage",
        "name": "Anahtar Teslim İnşaat Hizmetleri",
        "description": "AR-KAR İnşaat anahtar teslim inşaat hizmetleri: Samsun Çarşamba'da villa, konut, fabrika ve ticari bina inşaatı. ${EXPERIENCE_YEARS} yıllık deneyimle profesyonel müteahhitlik hizmetleri.",
        "url": "https://ar-kar.com/muteahhitlik",
        "mainEntity": {
            "@type": "LocalBusiness",
            "@id": "https://ar-kar.com/#organization",
            "name": "AR-KAR GIDA TARIM ÜRÜNLERİ VE TAŞIMACILIK TİCARET LİMİTED ŞİRKETİ",
            "alternateName": "AR-KAR İnşaat",
            "url": "https://ar-kar.com",
            "telephone": ["+90 362 846 03 93", "+90 362 834 18 48"],
            "email": "arkargida@gmail.com",
            "address": {
                "@type": "PostalAddress",
                "addressLocality": "Çarşamba",
                "addressRegion": "Samsun",
                "addressCountry": "TR"
            },
            "geo": {
                "@type": "GeoCoordinates",
                "latitude": 41.1986,
                "longitude": 36.7153
            },
            "openingHours": "Mo-Sa 08:00-18:00",
            "areaServed": {
                "@type": "GeoCircle",
                "geoMidpoint": {
                    "@type": "GeoCoordinates",
                    "latitude": 41.1986,
                    "longitude": 36.7153
                },
                "geoRadius": "50000"
            }
        },
        "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "AR-KAR Anahtar Teslim İnşaat Hizmetleri",
            "itemListElement": [
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Service",
                        "name": "Villa İnşaatı",
                        "description": "Anahtar teslim villa inşaat hizmetleri, modern tasarım ve kaliteli malzemelerle",
                        "category": "Anahtar Teslim İnşaat",
                        "provider": {
                            "@type": "Organization",
                            "name": "AR-KAR İnşaat"
                        }
                    }
                },
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Service",
                        "name": "Konut İnşaatı",
                        "description": "Tek ve çok katlı konut binalarının anahtar teslim inşaatı",
                        "category": "Anahtar Teslim İnşaat",
                        "provider": {
                            "@type": "Organization",
                            "name": "AR-KAR İnşaat"
                        }
                    }
                },
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Service",
                        "name": "Endüstriyel İnşaat",
                        "description": "Fabrika, depo ve endüstriyel tesislerin anahtar teslim inşaatı",
                        "category": "Anahtar Teslim İnşaat",
                        "provider": {
                            "@type": "Organization",
                            "name": "AR-KAR İnşaat"
                        }
                    }
                },
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Service",
                        "name": "Ticari Bina İnşaatı",
                        "description": "Mağaza, ofis ve ticari binaların anahtar teslim inşaatı",
                        "category": "Anahtar Teslim İnşaat",
                        "provider": {
                            "@type": "Organization",
                            "name": "AR-KAR İnşaat"
                        }
                    }
                }
            ]
        }
    }`} />
  </Fragment>

  <PageHeader active="Anahtar Teslim İnşaat" />

    <!-- Services Section Start -->
    <div class="container-fluid py-6 px-3 px-md-5">
        <!-- Overview Section -->
        <div class="row align-items-center mb-5">
            <div class="col-lg-7 pe-lg-5">
                <SectionHeader as="h1" align="left" accent="Anahtar Teslim İnşaat" title="Proje Uygulama" />
                <p class="mb-4">
                    Anahtar teslim inşaat proje ve uygulama işlerinde biz tecrübeli teknik kadromuz ile inşaatınız ile ilgili tüm proje ve yapım işlerinizde yanınızdayız.
                </p>
                <p class="mb-4">
                    AR-KAR, yapı inşaat projelerinizde proje yönetimi, teknik danışmanlık ve inşaat uygulama danışmanlığı hizmetleri vermektedir. İnşaat sektöründe, işinizi güvenilir bir şekilde daha hızlı ve daha verimli hale getirmek için projelerinize özel çözümler sunmak üzere teknik mühendis ve mimar uzmanlarımıza güvenebilirsiniz.
                </p>
                <p class="mb-4">
                    Bizler, oluşabilecek riskleri azaltmanıza, resmi ve uygulama süreçlerinizi düzene koymanıza ve daha sürdürülebilir bir şekilde çalışmanıza yardımcı olacak bağımsız hizmetler sunmak için sizinle işbirliği yapıyoruz.
                </p>
                <div class="bg-light p-4 rounded-3 mt-4">
                    <p class="mb-2 text-dark">
                        <strong>AR-KAR,</strong> profesyonel proje yönetimi, teknik danışmanlık ve şantiye denetimi hizmetleri sunan güçlü bir mühendis, mimar, plancı, danışman ve teknisyen ekibinden oluşmaktadır.
                    </p>
                    <p class="mb-0 text-primary">
                        <strong>Ana hedefimiz</strong> müşterilerimize en yüksek kalitede inşaat ve uygulama mühendislik hizmetleri sunmaktır. Değerlerimizi etik kurallarımızdan alırız.
                    </p>
                </div>
            </div>
            <div class="col-lg-5 ps-lg-4 mt-5 mt-lg-0">
                <div class="position-relative">
                    <img src="/img/anahtarteslim.webp" alt="Anahtar Teslim İnşaat - AR-KAR İnşaat" class="img-fluid rounded-3 shadow">
                    <div class="position-absolute top-0 start-0 bg-primary text-white p-3 rounded-3" style="margin: 20px;">
                        <h4 class="text-white mb-1">36+</h4>
                        <small>Yıllık Deneyim</small>
                    </div>
                    <div class="position-absolute bottom-0 end-0 bg-white p-3 rounded-3 shadow" style="margin: 20px; max-width: 200px;">
                        <div class="d-flex align-items-center">
                            <div class="me-3"><IconBadge icon="fa-award" tone="solid" /></div>
                            <div>
                                <h6 class="mb-1">Kalite Garantisi</h6>
                                <small class="text-muted">Profesyonel Ekip</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <CtaBand
          title="Anahtar Teslim İnşaat Projenizi Planlamaya Başlayalım!"
          text={`${EXPERIENCE_YEARS} yıllık deneyimimizle hayalinizdeki yapıyı gerçeğe dönüştürüyoruz. Ücretsiz keşif ve fiyat teklifi için hemen iletişime geçin.`}
          primaryHref="tel:+905421826855"
          primaryLabel="0542 182 68 55"
          primaryIcon="fa-phone"
          secondaryHref="https://wa.me/905421826855"
          secondaryLabel="WhatsApp"
          secondaryIcon="fab fa-whatsapp"
        />
    </div>
    <!-- Services Section End -->
</BaseLayout>
