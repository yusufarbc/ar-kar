    <style is:inline set:html={`/* Critical CSS for above-the-fold content */
        .navbar-brand img {
            transition: transform 0.3s ease;
        }
        
        .navbar-brand img:hover {
            transform: scale(1.05);
        }

        /* Lazy Loading Enhancement */
        img[loading="lazy"] {
            transition: opacity 0.3s ease;
        }

        /* Service cards hover effects */
        .service-item {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .service-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        }

        /* Button hover effects */
        .btn {
            transition: all 0.3s ease;
        }

        /* Accessibility improvements */
        .btn:focus,
        .nav-link:focus {
            outline: 2px solid var(--bs-primary);
            outline-offset: 2px;
        }

        /* Reduced motion support */
        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
        }
        
        /* Mobile optimizations */
        @media (max-width: 768px) {
            .service-item {
                margin-bottom: 2rem;
            }
            
            .display-5 {
                font-size: 2rem;
            }
            
            .display-6 {
                font-size: 1.8rem;
            }
            
            .py-6 {
                padding-top: 3rem !important;
                padding-bottom: 3rem !important;
            }
            
            .px-5 {
                padding-left: 1rem !important;
                padding-right: 1rem !important;
            }
            
            .text-uppercase {
                text-transform: none !important;
            }
            
            .footer .navbar-brand img {
                max-height: 60px !important;
                width: auto;
            }
        }
        
        @media (max-width: 576px) {
            .display-5 {
                font-size: 1.5rem;
            }
            
            .display-6 {
                font-size: 1.3rem;
            }
            
            .py-6 {
                padding-top: 2rem !important;
                padding-bottom: 2rem !important;
            }
        }
        
        /* WhatsApp floating button */
        .whatsapp-float {
            position: fixed;
            width: 60px;
            height: 60px;
            bottom: 20px;
            right: 20px;
            background-color: #25d366;
            color: white;
            border-radius: 50px;
            text-align: center;
            font-size: 30px;
            box-shadow: 2px 2px 3px #999;
            z-index: 1000;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
        }
        
        .whatsapp-float:hover {
            background-color: #20c55e;
            color: white;
            transform: scale(1.1);
            text-decoration: none;
        }
        
        @media (max-width: 768px) {
            .whatsapp-float {
                width: 55px;
                height: 55px;
                bottom: 15px;
                right: 15px;
                font-size: 25px;
            }
        }`} />
    <style is:inline set:html={`/* Service Card Styles */
        .service-card {
            transition: all 0.3s ease;
            border: none;
            overflow: hidden;
        }

        .service-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.15) !important;
        }

        .service-card .card-img-container {
            overflow: hidden;
            position: relative;
        }

        .service-card .card-img-top {
            transition: transform 0.3s ease;
        }

        .service-card:hover .card-img-top {
            transform: scale(1.05);
        }

        .service-badge {
            background: linear-gradient(135deg, var(--primary), #d63384);
            font-weight: 600;
            font-size: 0.9rem;
            border-radius: 0 0 15px 0 !important;
        }

        .service-card .card-title {
            color: var(--dark);
            font-weight: 700;
            line-height: 1.2;
            margin-bottom: 15px;
        }

        .service-card .list-unstyled li {
            padding: 5px 0;
            font-size: 0.9rem;
        }

        .service-card .btn {
            font-weight: 600;
            padding: 12px 20px;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

        .service-card .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(204, 39, 43, 0.3);
        }

        /* Process Section Styles */
        .process-step {
            position: relative;
            padding: 20px 0;
        }

        .process-step:not(:last-child)::after {
            content: '';
            position: absolute;
            top: 40px;
            right: -50%;
            width: 100%;
            height: 2px;
            background: linear-gradient(to right, var(--primary), transparent);
            z-index: 1;
        }

        .process-icon {
            background: linear-gradient(135deg, var(--primary), #d63384);
            transition: all 0.3s ease;
        }

        .process-step:hover .process-icon {
            transform: scale(1.1);
            box-shadow: 0 10px 20px rgba(204, 39, 43, 0.3);
        }

        /* Responsive Adjustments */
        @media (max-width: 768px) {
            .service-card .card-body {
                padding: 20px;
            }
            
            .process-step:not(:last-child)::after {
                display: none;
            }
            
            .service-badge {
                font-size: 0.8rem;
                padding: 8px 12px;
            }
        }

        @media (min-width: 992px) {
            .service-card .card-body {
                padding: 30px;
            }
        }

        /* Animation for service cards */
        .service-card {
            opacity: 0;
            animation: fadeInUp 0.6s ease forwards;
        }

        .service-card:nth-child(1) { animation-delay: 0.1s; }
        .service-card:nth-child(2) { animation-delay: 0.2s; }
        .service-card:nth-child(3) { animation-delay: 0.3s; }
        .service-card:nth-child(4) { animation-delay: 0.4s; }
        .service-card:nth-child(5) { animation-delay: 0.5s; }
        .service-card:nth-child(6) { animation-delay: 0.6s; }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Section background */
        .services-section {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            position: relative;
        }

        .services-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 100px;
            background: linear-gradient(to bottom, rgba(204, 39, 43, 0.05), transparent);
        }

        /* Call to action styles */
        .cta-section {
            background: linear-gradient(135deg, var(--primary), #d63384);
            position: relative;
            overflow: hidden;
        }

        .cta-section::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="2" fill="rgba(255,255,255,0.1)"/></svg>') repeat;
            animation: float 20s infinite linear;
        }

        @keyframes float {
            0% { transform: translate(-50%, -50%) rotate(0deg); }
            100% { transform: translate(-50%, -50%) rotate(360deg); }
        }`} />
  </Fragment>

