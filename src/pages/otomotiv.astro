---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "AR-KAR Otomotiv Alım Satım | Binek ve Ticari Araç | Samsun Çarşamba";
const description = "AR-KAR İnşaat Otomotiv Alım Satım bölümü olarak Samsun Çarşamba'da binek ve ticari araçlarda güvenilir alım-satım hizmetleri sunuyoruz. Ekspertizli, belgeli ve güvenilir araç portföyümüzle hizmetinizdeyiz.";
const canonical = "https://ar-kar.com/otomotiv";
const ogImage = "https://ar-kar.com/img/otomotiv.webp";
const keywords = "ar-kar otomotiv, araç alım satım, ikinci el araç, binek araç, ticari araç, samsun araç alım satım, çarşamba galeri, ekspertiz, belgeli araç";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  keywords={keywords}
  activePage="otomotiv"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={`{
        "@context": "https://schema.org",
        "@type": "AutomotiveBusiness",
        "name": "AR-KAR Otomotiv Alım Satım",
        "description": "Samsun Çarşamba'da binek ve ticari araçlarda güvenilir alım-satım hizmetleri sunuyoruz. Ekspertizli, belgeli ve güvenilir araç portföyü.",
        "provider": {
            "@type": "Organization",
            "name": "AR-KAR İnşaat Gıda Tarım Ürünleri ve Taş. Tic. Ltd. Şti.",
            "address": {
                "@type": "PostalAddress",
                "streetAddress": "Orta Mah. Dr. Orhan Atılgan Cad. No:24/A",
                "addressLocality": "Çarşamba",
                "addressRegion": "Samsun",
                "addressCountry": "TR"
            },
            "telephone": "+90 362 846 03 93",
            "email": "arkargida@gmail.com"
        },
        "areaServed": "Samsun, Türkiye",
        "serviceType": "Otomotiv Alım Satım",
        "offers": [
            {
                "@type": "Offer",
                "name": "Binek Araç Alım Satım",
                "description": "Ekspertizli binek araç alım ve satım hizmetleri"
            },
            {
                "@type": "Offer", 
                "name": "Ticari Araç Alım Satım",
                "description": "Belgeli ticari araç alım ve satım hizmetleri"
            },
            {
                "@type": "Offer",
                "name": "Araç Ekspertiz Hizmeti",
                "description": "Profesyonel araç ekspertiz ve değerlendirme hizmetleri"
            }
        ]
    }`} />
    <style is:inline set:html={`/* Critical CSS for above-the-fold content */
        .navbar-brand img {
            transition: transform 0.3s ease;
        }
        
        .navbar-brand img:hover {
            transform: scale(1.05);
        }

        /* Lazy Loading Enhancement */
        img[loading="lazy"] {
            transition: opacity 0.3s ease;
        }

        /* Automotive service cards */
        .automotive-card {
            background: white;
            border-radius: 15px;
            padding: 2rem;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
            text-align: center;
            height: 100%;
            border-top: 4px solid var(--bs-primary);
        }

        .automotive-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.15);
        }

        .automotive-icon {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: var(--bs-primary);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
            font-size: 2rem;
        }

        /* Vehicle showcase */
        .vehicle-showcase {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            border-radius: 20px;
            padding: 3rem;
            text-align: center;
            margin-bottom: 3rem;
        }

        .showcase-icon {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: var(--bs-primary);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 2rem;
            font-size: 3rem;
        }

        /* Trust badges */
        .trust-badge {
            background: white;
            border-radius: 10px;
            padding: 1.5rem;
            text-align: center;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            margin-bottom: 1rem;
        }

        .badge-icon {
            color: var(--bs-success);
            font-size: 2.5rem;
            margin-bottom: 1rem;
        }

        /* Contact CTA */
        .contact-cta {
            background: var(--bs-primary);
            color: white;
            border-radius: 15px;
            padding: 2rem;
            text-align: center;
        }

        .contact-cta .btn {
            background: white;
            color: var(--bs-primary);
            border: none;
            padding: 0.75rem 2rem;
            border-radius: 25px;
            font-weight: 600;
        }

        .contact-cta .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        }

        /* Accessibility improvements */
        .btn:focus,
        .nav-link:focus,
        .automotive-card:focus {
            outline: 2px solid var(--bs-primary);
            outline-offset: 2px;
        }

        /* Reduced motion support */
        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
        }

        /* Mobile optimizations */
        @media (max-width: 768px) {
            .automotive-card {
                padding: 1.5rem;
            }
            
            .vehicle-showcase {
                padding: 2rem;
            }
            
            .showcase-icon {
                width: 80px;
                height: 80px;
                font-size: 2rem;
            }
            
            .display-5 {
                font-size: 2rem;
            }
            
            .py-6 {
                padding-top: 3rem !important;
                padding-bottom: 3rem !important;
            }
            
            .footer .navbar-brand img {
                max-height: 60px !important;
                width: auto;
            }
        }
        
        /* WhatsApp floating button */
        .whatsapp-float {
            position: fixed;
            width: 60px;
            height: 60px;
            bottom: 20px;
            right: 20px;
            background-color: #25d366;
            color: white;
            border-radius: 50px;
            text-align: center;
            font-size: 30px;
            box-shadow: 2px 2px 3px #999;
            z-index: 1000;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
        }
        
        .whatsapp-float:hover {
            background-color: #20c55e;
            color: white;
            transform: scale(1.1);
            text-decoration: none;
        }
        
        @media (max-width: 768px) {
            .whatsapp-float {
                width: 55px;
                height: 55px;
                bottom: 15px;
                right: 15px;
                font-size: 25px;
            }
        }`} />
  </Fragment>

  <!-- Breadcrumb Start -->
    <div class="container-fluid bg-dark py-3 px-sm-3 px-md-5">
        <div class="row">
            <div class="col-md-12">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/" class="text-primary">Anasayfa</a></li>
                        <li class="breadcrumb-item"><a href="/#service" class="text-primary">Hizmetler</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">Otomotiv Alım Satım</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
    <!-- Breadcrumb End -->


    <!-- Service Overview Start -->
    <div class="container-fluid py-6 px-5">
        <div class="row g-5">
            <div class="col-lg-8">
                <h1 class="display-5 text-uppercase mb-4">AR-KAR <span class="text-primary">Otomotiv</span> Alım Satım</h1>
                <h4 class="text-uppercase mb-4 text-primary">Güvenilir Araç Alım-Satım Hizmetleri</h4>
                <p class="mb-4">AR-KAR olarak, 36 yıllık güven ve kalite anlayışımızı otomotiv sektörüne de taşıyarak, binek ve ticari araçlarda güvenilir alım-satım hizmetleri sunuyoruz. Ekspertizli, belgeli ve güvenilir araç portföyümüzle müşterilerimize doğru yatırımlar yapma imkânı sağlıyoruz.</p>
                <p class="mb-4">Deneyimli ekibimiz ile araç değerlendirmesi, ekspertiz işlemleri ve satış sonrası destek hizmetleri sunarak, hem alıcı hem de satıcı müşterilerimizin memnuniyetini sağlıyoruz. Şeffaf fiyatlandırma ve güvenilir işlem garantisi ile yanınızdayız.</p>
                
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="d-flex">
                            <i class="fa fa-check-circle fa-2x text-primary flex-shrink-0 me-3"></i>
                            <div>
                                <h5>Ekspertizli Araçlar</h5>
                                <p class="mb-0">Tüm araçlarımız profesyonel ekspertiz raporlu ve belgeli.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex">
                            <i class="fa fa-check-circle fa-2x text-primary flex-shrink-0 me-3"></i>
                            <div>
                                <h5>Şeffaf Fiyatlandırma</h5>
                                <p class="mb-0">Adil ve piyasa değerinde şeffaf fiyat politikası.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex">
                            <i class="fa fa-check-circle fa-2x text-primary flex-shrink-0 me-3"></i>
                            <div>
                                <h5>Hızlı İşlem</h5>
                                <p class="mb-0">Alım-satım işlemlerinde hızlı ve güvenli hizmet.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex">
                            <i class="fa fa-check-circle fa-2x text-primary flex-shrink-0 me-3"></i>
                            <div>
                                <h5>36 Yıllık Güven</h5>
                                <p class="mb-0">Sektördeki köklü tecrübemizle güvenilir hizmet.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 pb-4" style="min-height: 400px;">
                <div class="position-relative h-100 ms-5">
                    <img class="position-absolute w-100 h-100 mt-5 ms-n5" src="/img/arabalimsatim.webp" style="object-fit: cover;">
                </div>
            </div>
        </div>
    </div>
    <!-- Service Overview End -->

 

    <!-- CTA Section Start -->
    <div class="container-fluid bg-primary py-6 px-5">
        <div class="row g-5 align-items-center">
            <div class="col-lg-8">
                <h2 class="display-6 text-white mb-4">Kaliteli Araç Alım Satım Hizmeti Arıyorsanız</h2>
                <p class="text-white mb-0">AR-KAR  Otomotiv bölümü ile iletişime geçin. Kalite ve güven bizim önceliğimizdir.</p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <button class="btn btn-light btn-lg py-3 px-5" data-bs-toggle="modal" data-bs-target="#contactModal">
                    <i class="fa fa-phone me-2"></i>Hemen Arayın
                </button>
            </div>
        </div>
    </div>
    <!-- CTA Section End -->
</BaseLayout>
