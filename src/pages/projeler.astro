    <style is:inline set:html={`/* Lazy Loading Enhancement */
        img[loading="lazy"] {
            transition: opacity 0.3s ease;
        }

        /* Portfolio optimizations */
        .portfolio-box {
            overflow: hidden;
            border-radius: 8px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            background: white;
            height: 100%;
            display: flex;
            flex-direction: column;
            min-height: 100%;
        }

        .portfolio-box:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
        }

        .portfolio-box img {
            transition: transform 0.3s ease;
            width: 100%;
            height: 300px;
            object-fit: cover;
            flex-shrink: 0;
        }

        .portfolio-box:hover img {
            transform: scale(1.05);
        }

        .portfolio-title {
            padding: 20px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 0;
        }

        .portfolio-title h2 {
            font-size: 1.1rem;
            margin-bottom: 10px;
            color: #333;
            flex-shrink: 0;
        }

        .portfolio-title span {
            font-size: 0.9rem;
            color: #666;
            display: block;
            margin-bottom: 5px;
            flex-shrink: 0;
        }

        .portfolio-title p {
            margin-top: auto;
            font-size: 0.85rem;
            line-height: 1.4;
            flex-grow: 1;
            display: flex;
            align-items: flex-end;
        }

        /* Accessibility improvements */
        .portfolio-title:focus,
        .portfolio-btn:focus {
            outline: 2px solid var(--primary);
            outline-offset: 2px;
        }

        /* Reduced motion support */
        @media (prefers-reduced-motion: reduce) {

            .portfolio-box,
            .portfolio-box img {
                transition: none !important;
            }
        }

        /* Mobile optimizations */
        @media (max-width: 768px) {
            .portfolio-box {
                margin-bottom: 2rem;
            }

            .portfolio-box img {
                height: 220px;
            }

            .portfolio-title {
                padding: 15px;
            }

            .display-5 {
                font-size: 2rem;
            }

            .display-6 {
                font-size: 1.8rem;
            }

            .py-6 {
                padding-top: 3rem !important;
                padding-bottom: 3rem !important;
            }

            .px-5 {
                padding-left: 1rem !important;
                padding-right: 1rem !important;
            }

            .text-uppercase {
                text-transform: none !important;
            }

            .footer .navbar-brand img {
                max-height: 60px !important;
                width: auto;
            }
        }

        @media (max-width: 576px) {
            .portfolio-box img {
                height: 200px;
            }

            .display-5 {
                font-size: 1.5rem;
            }

            .display-6 {
                font-size: 1.3rem;
            }

            .py-6 {
                padding-top: 2rem !important;
                padding-bottom: 2rem !important;
            }
        }

        /* Tablet optimizations */
        @media (min-width: 769px) and (max-width: 1024px) {
            .portfolio-box img {
                height: 280px;
            }
        }

        /* WhatsApp floating button */
        .whatsapp-float {
            position: fixed;
            width: 60px;
            height: 60px;
            bottom: 20px;
            right: 20px;
            background-color: #25d366;
            color: white;
            border-radius: 50px;
            text-align: center;
            font-size: 30px;
            box-shadow: 2px 2px 3px #999;
            z-index: 1000;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
        }

        .whatsapp-float:hover {
            background-color: #20c55e;
            color: white;
            transform: scale(1.1);
            text-decoration: none;
        }

        @media (max-width: 768px) {
            .whatsapp-float {
                width: 55px;
                height: 55px;
                bottom: 15px;
                right: 15px;
                font-size: 25px;
            }
        }`} />
