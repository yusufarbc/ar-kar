---
import { EXPERIENCE_YEARS } from '../lib/company';
import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { PROJECT_CATEGORIES } from '../lib/projects';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Card from '../components/ui/Card.astro';
import CardMedia from '../components/ui/CardMedia.astro';
import Badge from '../components/ui/Badge.astro';

// Keystatic panelinden (panel.ar-kar.com) eklenen projeler.
// Aşağıdaki statik portfolyo bölümü referans projeler olarak korunur;
// CMS'ten gelen kayıtlar ayrı bir bölümde listelenir.
const cmsProjects = (await getCollection('projects')).sort((a, b) =>
  String(b.data.date ?? '').localeCompare(String(a.data.date ?? ''))
);

const title = "Konut İnşaat Projeleri | AR-KAR İnşaat Samsun | Samsun'da Modern Konut Projeleri";
const description = `AR-KAR İnşaat konut projeleri: Çarşamba Kirazlıkçay, Adapark, Bulutoğlu, Atakum Beypınar ve Körfez'de modern konut projeleri. Akıllı ev sistemli, 2+1, 3+1 daireler. ${EXPERIENCE_YEARS} yıllık deneyimle kaliteli inşaat.`;
const canonical = "https://ar-kar.com/projeler";
const ogImage = "https://ar-kar.com/img/projects/kirazlikcay.webp";
const keywords = "konut projeleri samsun, çarşamba konut inşaat, atakum konut projesi, ar-kar konut, adapark konut, beypınar konut, kirazlıkçay konut, körfez konut, bulutoğlu konut, akıllı ev sistemi, 2+1 daire, 3+1 daire, modern konut çarşamba";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  keywords={keywords}
  activePage="projeler"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={`{
        "@context": "https://schema.org",
        "@type": "WebPage",
        "name": "Konut İnşaat Projeleri",
        "description": "AR-KAR İnşaat konut projeleri: Samsun Çarşamba'da modern 2+1 ve 1+1 daire projeleri, Atakum Beypınar konut projesi, tekstil fabrikası inşaatı.",
        "url": "https://ar-kar.com/projeler",
        "mainEntity": {
            "@type": "Organization",
            "name": "AR-KAR İnşaat",
            "url": "https://ar-kar.com"
        },
        "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "AR-KAR Konut Projeleri",
            "itemListElement": [
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Product",
                        "name": "Çarşamba Kirazlıkçay Konut Projesi",
                        "description": "Doğayla iç içe, manzaralı konumda 8 adet 2+1 ve 10 adet 1+1 toplam 18 daire",
                        "category": "Konut İnşaat Projesi"
                    }
                },
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Product",
                        "name": "Atakum Beypınar Konut Projesi",
                        "description": "Modern mimari anlayışla 18 adet 120 m² 2+1 daire projesi",
                        "category": "Konut İnşaat Projesi"
                    }
                },
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Product",
                        "name": "Çarşamba Adapark 2+0 Konut Projesi",
                        "description": "6 adet 80 m² 2+0 daire ve 1 dükkan prestijli konumda",
                        "category": "Konut İnşaat Projesi"
                    }
                },
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Product",
                        "name": "Atakum Körfez Konut Projesi",
                        "description": "19 adet 1+1 daire, tramvay ve marinaya yakın konum",
                        "category": "Konut İnşaat Projesi"
                    }
                },
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Product",
                        "name": "Çarşamba Bulutoğlu Konut Projesi",
                        "description": "8 adet 3+1 daire ve 1 dükkan stratejik konumda",
                        "category": "Konut İnşaat Projesi"
                    }
                },
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Product",
                        "name": "Çarşamba Adapark Ala Konut Projesi",
                        "description": "12 adet 160 m² 3+1 daire, akıllı ev sistemi ile",
                        "category": "Konut İnşaat Projesi"
                    }
                },
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Product",
                        "name": "Çarşamba Adapark Ala Plus Konut Projesi",
                        "description": "12 adet 135 m² 3+1 daire, kaymakamlık karşısında",
                        "category": "Konut İnşaat Projesi"
                    }
                }
            ]
        }
    }`} />
    <script is:inline type="application/ld+json" set:html={`{
        "@context": "https://schema.org",
        "@type": "ItemList",
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "item": {
                    "@type": "Product",
                    "name": "Çarşamba Kirazlıkçay Konut Projesi",
                    "description": "18 daire (8x2+1, 10x1+1), Çarşamba TOKİ arka taraf",
                    "image": "https://ar-kar.com/img/projects/kirazlikcay.webp"
                }
            },
            {
                "@type": "ListItem",
                "position": 2,
                "item": {
                    "@type": "Product",
                    "name": "Atakum Beypınar Konut Projesi",
                    "description": "18 adet 2+1 daire (120m²), Gökdelenler bölgesi",
                    "image": "https://ar-kar.com/img/projects/beypinar.webp"
                }
            },
            {
                "@type": "ListItem",
                "position": 3,
                "item": {
                    "@type": "Product",
                    "name": "Çarşamba Adapark 2+0 Konut Projesi",
                    "description": "6 adet 2+0 daire (80m²) + 1 dükkan",
                    "image": "https://ar-kar.com/img/projects/adapark2-0.webp"
                }
            },
            {
                "@type": "ListItem",
                "position": 4,
                "item": {
                    "@type": "Product",
                    "name": "Atakum Körfez Konut Projesi",
                    "description": "19 adet 1+1 daire, tramvay ve marina yakını",
                    "image": "https://ar-kar.com/img/projects/korfez.webp"
                }
            },
            {
                "@type": "ListItem",
                "position": 5,
                "item": {
                    "@type": "Product",
                    "name": "Çarşamba Bulutoğlu Konut Projesi",
                    "description": "8 adet 3+1 daire + 1 dükkan",
                    "image": "https://ar-kar.com/img/projects/bulutoglu.webp"
                }
            },
            {
                "@type": "ListItem",
                "position": 6,
                "item": {
                    "@type": "Product",
                    "name": "Çarşamba Adapark Ala Konut Projesi",
                    "description": "12 adet 3+1 daire (160m²) + 2 dükkan, akıllı ev sistemi",
                    "image": "https://ar-kar.com/img/projects/ala.webp"
                }
            },
            {
                "@type": "ListItem",
                "position": 7,
                "item": {
                    "@type": "Product",
                    "name": "Çarşamba Adapark Ala Plus Konut Projesi",
                    "description": "12 adet 3+1 daire (135m²) + 2 dükkan",
                    "image": "https://ar-kar.com/img/projects/alaplus.webp"
                }
            },
            {
                "@type": "ListItem",
                "position": 8,
                "item": {
                    "@type": "Product",
                    "name": "Çarşamba Tekstilkent Projesi",
                    "description": "975m² idare + 2900m² üretim = 3875m² tekstil tesisi",
                    "image": "https://ar-kar.com/img/projects/tekstilkent.webp"
                }
            }
        ]
    }`} />
  </Fragment>

  <PageHeader active="İnşaat Projeleri" />

    <!-- Portfolio Start -->
    <div class="container-fluid bg-light py-6 px-5">

        <SectionHeader
          as="h1"
          accent="AR-KAR İnşaat"
          title="Projelerimiz"
          lede={`Samsun Çarşamba ve Atakum'da ${EXPERIENCE_YEARS} yıllık deneyimimizle hayata geçirdiğimiz modern konut projeleri. Doğayla iç içe, konforlu yaşam alanları ve kaliteli inşaat anlayışımızla projelerimizi keşfedin.`}
        />

        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-4 align-items-stretch">
            {cmsProjects.map((project) => {
                const slug = project.id.replace(/\/index$/, '');
                const cover = project.data.coverImage || '/img/card-default.webp';
                const categoryLabel = PROJECT_CATEGORIES[project.data.category];
                return (
                    <div class="col d-flex">
                        <Card padded={false} hoverable={true} class="flex-fill d-flex flex-column h-100">
                            <a href={cover} data-lightbox="portfolio" aria-label={`${project.data.title} görselini büyüt`}>
                                <CardMedia src={cover} alt={project.data.title}>
                                    {categoryLabel && <Badge slot="badge" label={categoryLabel} />}
                                </CardMedia>
                            </a>
                            <div class="card-surface__body flex-grow-1 d-flex flex-column">
                                <h2 class="h5">
                                    <a href={`/projeler/${slug}`} class="text-decoration-none text-reset">{project.data.title}</a>
                                </h2>
                                {project.data.location && (
                                    <span class="small text-body-secondary d-block"><i class="fa fa-map-marker-alt text-primary me-2" aria-hidden="true"></i>{project.data.location}</span>
                                )}
                                {project.data.specs && (
                                    <span class="small text-body-secondary d-block"><i class="fa fa-home text-primary me-2" aria-hidden="true"></i>{project.data.specs}</span>
                                )}
                                {project.data.description && (
                                    <p class="mt-3 text-muted">{project.data.description}</p>
                                )}
                                <div class="mt-auto pt-2">
                                    <a href={`/projeler/${slug}`} class="btn btn-sm btn-primary px-3">
                                        Detayları Gör <i class="fa fa-arrow-right ms-1" aria-hidden="true"></i>
                                    </a>
                                </div>
                            </div>
                        </Card>
                    </div>
                );
            })}
        </div>

    </div>
    <!-- Portfolio End -->
</BaseLayout>
