---
import { EXPERIENCE_YEARS } from '../lib/company';
import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { PROJECT_CATEGORIES } from '../lib/projects';

// Keystatic panelinden (panel.ar-kar.com) eklenen projeler.
// Aşağıdaki statik portfolyo bölümü referans projeler olarak korunur;
// CMS'ten gelen kayıtlar ayrı bir bölümde listelenir.
const cmsProjects = (await getCollection('projects')).sort((a, b) =>
  String(b.data.date ?? '').localeCompare(String(a.data.date ?? ''))
);

const title = "Konut İnşaat Projeleri | AR-KAR İnşaat Samsun | Samsun'da Modern Konut Projeleri";
const description = `AR-KAR İnşaat konut projeleri: Çarşamba Kirazlıkçay, Adapark, Bulutoğlu, Atakum Beypınar ve Körfez'de modern konut projeleri. Akıllı ev sistemli, 2+1, 3+1 daireler. ${EXPERIENCE_YEARS} yıllık deneyimle kaliteli inşaat.`;
const canonical = "https://ar-kar.com/projeler";
const ogImage = "https://ar-kar.com/img/kirazlikcay.webp";
const keywords = "konut projeleri samsun, çarşamba konut inşaat, atakum konut projesi, ar-kar konut, adapark konut, beypınar konut, kirazlıkçay konut, körfez konut, bulutoğlu konut, akıllı ev sistemi, 2+1 daire, 3+1 daire, modern konut çarşamba";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  keywords={keywords}
  activePage="projeler"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={`{
        "@context": "https://schema.org",
        "@type": "WebPage",
        "name": "Konut İnşaat Projeleri",
        "description": "AR-KAR İnşaat konut projeleri: Samsun Çarşamba'da modern 2+1 ve 1+1 daire projeleri, Atakum Beypınar konut projesi, tekstil fabrikası inşaatı.",
        "url": "https://ar-kar.com/projeler",
        "mainEntity": {
            "@type": "Organization",
            "name": "AR-KAR İnşaat",
            "url": "https://ar-kar.com"
        },
        "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "AR-KAR Konut Projeleri",
            "itemListElement": [
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Product",
                        "name": "Çarşamba Kirazlıkçay Konut Projesi",
                        "description": "Doğayla iç içe, manzaralı konumda 8 adet 2+1 ve 10 adet 1+1 toplam 18 daire",
                        "category": "Konut İnşaat Projesi"
                    }
                },
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Product",
                        "name": "Atakum Beypınar Konut Projesi",
                        "description": "Modern mimari anlayışla 18 adet 120 m² 2+1 daire projesi",
                        "category": "Konut İnşaat Projesi"
                    }
                },
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Product",
                        "name": "Çarşamba Adapark 2+0 Konut Projesi",
                        "description": "6 adet 80 m² 2+0 daire ve 1 dükkan prestijli konumda",
                        "category": "Konut İnşaat Projesi"
                    }
                },
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Product",
                        "name": "Atakum Körfez Konut Projesi",
                        "description": "19 adet 1+1 daire, tramvay ve marinaya yakın konum",
                        "category": "Konut İnşaat Projesi"
                    }
                },
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Product",
                        "name": "Çarşamba Bulutoğlu Konut Projesi",
                        "description": "8 adet 3+1 daire ve 1 dükkan stratejik konumda",
                        "category": "Konut İnşaat Projesi"
                    }
                },
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Product",
                        "name": "Çarşamba Adapark Ala Konut Projesi",
                        "description": "12 adet 160 m² 3+1 daire, akıllı ev sistemi ile",
                        "category": "Konut İnşaat Projesi"
                    }
                },
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Product",
                        "name": "Çarşamba Adapark Ala Plus Konut Projesi",
                        "description": "12 adet 135 m² 3+1 daire, kaymakamlık karşısında",
                        "category": "Konut İnşaat Projesi"
                    }
                }
            ]
        }
    }`} />
    <script is:inline type="application/ld+json" set:html={`{
        "@context": "https://schema.org",
        "@type": "ItemList",
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "item": {
                    "@type": "Product",
                    "name": "Çarşamba Kirazlıkçay Konut Projesi",
                    "description": "18 daire (8x2+1, 10x1+1), Çarşamba TOKİ arka taraf",
                    "image": "https://ar-kar.com/img/kirazlikcay.webp"
                }
            },
            {
                "@type": "ListItem",
                "position": 2,
                "item": {
                    "@type": "Product",
                    "name": "Atakum Beypınar Konut Projesi",
                    "description": "18 adet 2+1 daire (120m²), Gökdelenler bölgesi",
                    "image": "https://ar-kar.com/img/beypinar.webp"
                }
            },
            {
                "@type": "ListItem",
                "position": 3,
                "item": {
                    "@type": "Product",
                    "name": "Çarşamba Adapark 2+0 Konut Projesi",
                    "description": "6 adet 2+0 daire (80m²) + 1 dükkan",
                    "image": "https://ar-kar.com/img/adapark2-0.webp"
                }
            },
            {
                "@type": "ListItem",
                "position": 4,
                "item": {
                    "@type": "Product",
                    "name": "Atakum Körfez Konut Projesi",
                    "description": "19 adet 1+1 daire, tramvay ve marina yakını",
                    "image": "https://ar-kar.com/img/korfez.webp"
                }
            },
            {
                "@type": "ListItem",
                "position": 5,
                "item": {
                    "@type": "Product",
                    "name": "Çarşamba Bulutoğlu Konut Projesi",
                    "description": "8 adet 3+1 daire + 1 dükkan",
                    "image": "https://ar-kar.com/img/bulutoglu.webp"
                }
            },
            {
                "@type": "ListItem",
                "position": 6,
                "item": {
                    "@type": "Product",
                    "name": "Çarşamba Adapark Ala Konut Projesi",
                    "description": "12 adet 3+1 daire (160m²) + 2 dükkan, akıllı ev sistemi",
                    "image": "https://ar-kar.com/img/ala.webp"
                }
            },
            {
                "@type": "ListItem",
                "position": 7,
                "item": {
                    "@type": "Product",
                    "name": "Çarşamba Adapark Ala Plus Konut Projesi",
                    "description": "12 adet 3+1 daire (135m²) + 2 dükkan",
                    "image": "https://ar-kar.com/img/alaplus.webp"
                }
            },
            {
                "@type": "ListItem",
                "position": 8,
                "item": {
                    "@type": "Product",
                    "name": "Çarşamba Tekstilkent Projesi",
                    "description": "975m² idare + 2900m² üretim = 3875m² tekstil tesisi",
                    "image": "https://ar-kar.com/img/tekstilkent.webp"
                }
            }
        ]
    }`} />
    <style is:inline set:html={`/* Lazy Loading Enhancement */
        img[loading="lazy"] {
            transition: opacity 0.3s ease;
        }

        /* Portfolio optimizations */
        .portfolio-box {
            overflow: hidden;
            border-radius: 8px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            background: var(--surface);
            height: 100%;
            display: flex;
            flex-direction: column;
            min-height: 100%;
        }

        .portfolio-box:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
        }

        .portfolio-box img {
            transition: transform 0.3s ease;
            width: 100%;
            height: 300px;
            object-fit: cover;
            flex-shrink: 0;
        }

        .portfolio-box:hover img {
            transform: scale(1.05);
        }

        .portfolio-title {
            padding: 20px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 0;
        }

        .portfolio-title h2 {
            font-size: 1.1rem;
            margin-bottom: 10px;
            color: var(--ink-700);
            flex-shrink: 0;
        }

        .portfolio-title span {
            font-size: 0.9rem;
            color: var(--ink-500);
            display: block;
            margin-bottom: 5px;
            flex-shrink: 0;
        }

        .portfolio-title p {
            margin-top: auto;
            font-size: 0.85rem;
            line-height: 1.4;
            flex-grow: 1;
            display: flex;
            align-items: flex-end;
        }

        /* Accessibility improvements */
        .portfolio-title:focus,
        .portfolio-btn:focus {
            outline: 2px solid var(--primary);
            outline-offset: 2px;
        }

        /* Reduced motion support */
        @media (prefers-reduced-motion: reduce) {

            .portfolio-box,
            .portfolio-box img {
                transition: none !important;
            }
        }

        /* Mobile optimizations */
        @media (max-width: 768px) {
            .portfolio-box {
                margin-bottom: 2rem;
            }

            .portfolio-box img {
                height: 220px;
            }

            .portfolio-title {
                padding: 15px;
            }

            .display-5 {
                font-size: 2rem;
            }

            .display-6 {
                font-size: 1.8rem;
            }

            .py-6 {
                padding-top: 3rem !important;
                padding-bottom: 3rem !important;
            }

            .px-5 {
                padding-left: 1rem !important;
                padding-right: 1rem !important;
            }

            .text-uppercase {
                text-transform: none !important;
            }

            .footer .navbar-brand img {
                max-height: 60px !important;
                width: auto;
            }
        }

        @media (max-width: 576px) {
            .portfolio-box img {
                height: 200px;
            }

            .display-5 {
                font-size: 1.5rem;
            }

            .display-6 {
                font-size: 1.3rem;
            }

            .py-6 {
                padding-top: 2rem !important;
                padding-bottom: 2rem !important;
            }
        }

        /* Tablet optimizations */
        @media (min-width: 769px) and (max-width: 1024px) {
            .portfolio-box img {
                height: 280px;
            }
        }

        /* WhatsApp floating button */
        .whatsapp-float {
            position: fixed;
            width: 60px;
            height: 60px;
            bottom: 20px;
            right: 20px;
            background-color: #25d366;
            color: white;
            border-radius: 50px;
            text-align: center;
            font-size: 30px;
            box-shadow: 2px 2px 3px #999;
            z-index: 1000;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
        }

        .whatsapp-float:hover {
            background-color: #20c55e;
            color: white;
            transform: scale(1.1);
            text-decoration: none;
        }

        @media (max-width: 768px) {
            .whatsapp-float {
                width: 55px;
                height: 55px;
                bottom: 15px;
                right: 15px;
                font-size: 25px;
            }
        }`} />
  </Fragment>

  <PageHeader active="İnşaat Projeleri" />

    <!-- Portfolio Start -->
    <div class="container-fluid bg-light py-6 px-5">

        <div class="text-center mx-auto mb-5" style="max-width: 800px;">
            <h1 class="display-5 text-uppercase mb-4"><span class="text-primary">AR-KAR İnşaat</span> Projelerimiz</h1>
            <p class="mb-4">Samsun Çarşamba ve Atakum'da {EXPERIENCE_YEARS} yıllık deneyimimizle hayata geçirdiğimiz modern konut
                projeleri. Doğayla iç içe, konforlu yaşam alanları ve kaliteli inşaat anlayışımızla projelerimizi
                keşfedin.</p>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-4 portfolio-container align-items-stretch">
            {cmsProjects.map((project) => {
                const slug = project.id.replace(/\/index$/, '');
                const cover = project.data.coverImage || '/img/about.webp';
                return (
                    <div class="col portfolio-item d-flex">
                        <div class="portfolio-box flex-fill d-flex flex-column h-100">
                            <a href={cover} data-lightbox="portfolio" class="portfolio-image">
                                <img class="img-fluid w-100" src={cover} alt={project.data.title} loading="lazy" />
                            </a>
                            <div class="portfolio-title flex-grow-1 d-flex flex-column">
                                <h2 class="text-uppercase">
                                    <a href={`/projeler/${slug}`} class="text-decoration-none text-reset">{project.data.title}</a>
                                </h2>
                                {project.data.location && (
                                    <span><i class="fa fa-map-marker-alt text-primary me-2"></i>{project.data.location}</span>
                                )}
                                {project.data.specs && (
                                    <span><i class="fa fa-home text-primary me-2"></i>{project.data.specs}</span>
                                )}
                                {project.data.description && (
                                    <p class="mt-3 text-muted">{project.data.description}</p>
                                )}
                                <div class="mt-auto pt-2">
                                    <a href={`/projeler/${slug}`} class="btn btn-sm btn-primary px-3">
                                        Detayları Gör <i class="fa fa-arrow-right ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                );
            })}
        </div>

    </div>
    <!-- Portfolio End -->
</BaseLayout>

<style>
    .project-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .project-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.12) !important;
    }
    .hover-primary:hover {
        color: var(--bs-primary) !important;
        transition: color 0.2s ease;
    }
</style>
