---
import PageHeader from '../../components/PageHeader.astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PROJECT_CATEGORIES } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => {
    const slug = project.id.replace(/\/index$/, '');
    return {
      params: { slug },
      props: { project },
    };
  });
}

const { project } = Astro.props;
const { slug } = Astro.params;
const { Content } = await render(project);

const categoryLabel = PROJECT_CATEGORIES[project.data.category];
const title = `${project.data.title} | AR-KAR İnşaat Samsun`;
const description =
  project.data.description ||
  `${project.data.title} - AR-KAR İnşaat ${categoryLabel} projesi.`;
const canonical = `https://ar-kar.com/projeler/${slug}`;
const coverImage = project.data.coverImage || '/img/card-default.webp';
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={coverImage.startsWith('http') ? coverImage : `https://ar-kar.com${coverImage}`}
  ogType="article"
  activePage="projeler"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'CreativeWork',
      name: project.data.title,
      description,
      url: canonical,
      image: coverImage.startsWith('http') ? coverImage : `https://ar-kar.com${coverImage}`,
      creator: {
        '@type': 'Organization',
        name: 'AR-KAR İnşaat',
        url: 'https://ar-kar.com',
      },
      ...(project.data.location ? { locationCreated: { '@type': 'Place', name: project.data.location } } : {}),
    })} />
  </Fragment>

  <PageHeader active={project.data.title} parents={[{ label: "Projeler", href: "/projeler" }]} />

  <!-- Project Detail Start -->
  <article class="container py-6">
    <div class="row justify-content-center">
      <div class="col-lg-9">
        <header class="mb-4">
          <div class="d-flex flex-wrap align-items-center text-muted mb-3 gap-3">
            <span class={`badge-pill ${project.data.status === 'guncel' ? '' : 'badge-pill--dark'}`}>
              <i class={`fa ${project.data.status === 'guncel' ? 'fa-spinner' : 'fa-check-circle'} me-1`} aria-hidden="true"></i>
              {project.data.status === 'guncel' ? 'Güncel Proje' : 'Tamamlanan Proje'}
            </span>
            {categoryLabel && <span class="badge-pill badge-pill--tint">{categoryLabel}</span>}
            {project.data.location && (
              <span><i class="fa fa-map-marker-alt text-primary me-2" aria-hidden="true"></i>{project.data.location}</span>
            )}
            {project.data.specs && (
              <span><i class="fa fa-home text-primary me-2" aria-hidden="true"></i>{project.data.specs}</span>
            )}
            {project.data.date && (
              <span><i class="fa fa-calendar-alt text-primary me-2" aria-hidden="true"></i>{project.data.date}</span>
            )}
          </div>
          <h1 class="display-6 fw-bold text-dark mb-4">{project.data.title}</h1>
          {project.data.description && (
            <p class="lead text-secondary border-start border-4 border-primary ps-3 py-1 mb-4">
              {project.data.description}
            </p>
          )}
        </header>

        {project.data.coverImage && (
          <div class="mb-5 rounded overflow-hidden shadow-sm">
            <a href={coverImage} data-lightbox="project" class="d-block">
              <img
                src={coverImage}
                alt={project.data.title}
                class="w-100 d-block"
                style="aspect-ratio: 4 / 3; object-fit: cover;"
              />
            </a>
          </div>
        )}

        <div class="project-content" style="font-size: 1.1rem; line-height: 1.8;">
          <Content />
        </div>

        {project.data.gallery && project.data.gallery.length > 0 && (
          <div class="mb-5">
            <h2 class="h5 text-uppercase mb-3">Proje Görselleri</h2>
            <div class="row g-3">
              {project.data.gallery.map((img) => (
                <div class="col-6 col-md-4">
                  <a href={img} data-lightbox="project-gallery" class="d-block rounded overflow-hidden shadow-sm" style="background: var(--surface-alt);">
                    <img src={img} alt={project.data.title} class="w-100" style="aspect-ratio: 4 / 3; object-fit: cover;" loading="lazy" />
                  </a>
                </div>
              ))}
            </div>
          </div>
        )}

        <hr class="my-5" />

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
          <a href="/projeler" class="btn btn-outline-primary">
            <i class="fa fa-arrow-left me-2" aria-hidden="true"></i>Tüm Projeler
          </a>
          <button
            type="button"
            class="btn btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#contactModal"
          >
            <i class="fa fa-envelope me-2" aria-hidden="true"></i>Bu Proje Hakkında Bilgi Alın
          </button>
        </div>
      </div>
    </div>
  </article>
  <!-- Project Detail End -->
</BaseLayout>

<style is:inline>
  .project-content h2, .project-content h3, .project-content h4 {
    color: var(--ink-900);
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-weight: 700;
  }
  .project-content p {
    margin-bottom: 1.25rem;
    color: var(--ink-700);
  }
  .project-content ul, .project-content ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }
  .project-content li {
    margin-bottom: 0.5rem;
    color: var(--ink-700);
  }
  .project-content img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 1.5rem 0;
  }
</style>
