---
import { EXPERIENCE_YEARS } from '../lib/company';
import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Card from '../components/ui/Card.astro';
import CardMedia from '../components/ui/CardMedia.astro';
import Badge from '../components/ui/Badge.astro';
import IconBadge from '../components/ui/IconBadge.astro';
import CtaBand from '../components/ui/CtaBand.astro';

const title = 'PVC Kapı ve Pencere Sistemleri | AR-KAR İnşaat Samsun | Kaliteli PVC Doğrama';
const description = `AR-KAR İnşaat PVC kapı ve pencere sistemleri: Samsun Çarşamba'da en kaliteli PVC doğrama, enerji verimli pencere sistemleri, cam balkon çözümleri. ${EXPERIENCE_YEARS} yıllık deneyimle profesyonel montaj.`;
const canonical = 'https://ar-kar.com/pvc';
const ogImage = 'https://ar-kar.com/img/pvc.webp';
const keywords = 'pvc kapı pencere samsun, pvc doğrama çarşamba, pvc pencere sistemleri, pvc kapı montajı, enerji verimli pencere, cam balkon sistemleri, pvc doğrama fiyatları, kaliteli pvc kapı';

// Bu sayfada hiç yapısal veri yoktu — diğer tüm hizmet sayfalarında varken
// PVC sayfası arama motorlarına yalnızca düz metin olarak görünüyordu.
// Şema, sayfada gerçekten anlatılan üç hizmet ve dört adımlı süreçle
// birebir örtüşür; sayfada olmayan hiçbir iddia eklenmemiştir.
const origin = (Astro.site ?? new URL('https://ar-kar.com')).origin;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'PVC Kapı ve Pencere Sistemleri',
  serviceType: 'PVC doğrama, montaj ve cam balkon',
  description,
  url: new URL('/pvc', origin).href,
  image: new URL('/img/pvc.webp', origin).href,
  inLanguage: 'tr-TR',
  provider: {
    '@type': 'LocalBusiness',
    name: 'AR-KAR İnşaat',
    url: origin,
    telephone: '+90 362 834 18 48',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Orta Mah. Dr. Orhan Atılgan Cad. No:24/A',
      addressLocality: 'Çarşamba',
      addressRegion: 'Samsun',
      postalCode: '55500',
      addressCountry: 'TR',
    },
  },
  areaServed: { '@type': 'AdministrativeArea', name: 'Samsun' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'PVC Sistemleri',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'PVC Pencere Sistemleri' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'PVC Kapı Sistemleri' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Cam Balkon Sistemleri' } },
    ],
  },
};

const SERVICES = [
  {
    img: '/img/pencere.webp',
    alt: 'PVC Pencere Sistemleri - AR-KAR İnşaat',
    badgeIcon: 'fas fa-window-maximize',
    badgeLabel: 'PVC Pencere',
    title: 'PVC Pencere Sistemleri',
    description:
      'Enerji verimli çift cam PVC pencere sistemleri ile ısı ve ses yalıtımı sağlıyoruz. Modern tasarım ve uzun ömürlü kullanım için kaliteli malzemeler kullanıyoruz.',
    features: ['Çift Cam Teknolojisi', 'Enerji Verimliliği', 'Ses Yalıtımı', 'UV Dayanıklılığı'],
  },
  {
    img: '/img/kapi.webp',
    alt: 'PVC Kapı Sistemleri - AR-KAR İnşaat',
    badgeIcon: 'fas fa-door-open',
    badgeLabel: 'PVC Kapı',
    title: 'PVC Kapı Sistemleri',
    description:
      'Güvenli ve yalıtımlı PVC kapı sistemleri ile hem estetik hem de fonksiyonel çözümler sunuyoruz. Çeşitli renk ve desen seçenekleriyle ihtiyaçlarınıza uygun kapılar üretiyoruz.',
    features: ['Güvenlik Sistemleri', 'Termal Kesim', 'Çoklu Kilit Sistemi', 'Renk Seçenekleri'],
  },
  {
    img: '/img/cambalkon.webp',
    alt: 'Cam Balkon Sistemleri - AR-KAR İnşaat',
    badgeIcon: 'fas fa-building',
    badgeLabel: 'Cam Balkon',
    title: 'Cam Balkon Sistemleri',
    description:
      'Modern cam balkon sistemleri ile balkonlarınızı kapatarak yaşam alanınızı genişletiyoruz. Sürme ve katlanır sistem seçenekleriyle pratik çözümler sunuyoruz.',
    features: ['Sürme Sistem', 'Katlanır Sistem', 'Temperli Cam', 'Hava Koşullarına Dayanıklı'],
  },
];

const PROCESS_STEPS = [
  { icon: 'fas fa-ruler-combined', title: '1. Ölçü Alma', text: 'Uzman ekibimiz ücretsiz keşif yaparak hassas ölçüler alır.' },
  { icon: 'fas fa-palette', title: '2. Tasarım & Seçim', text: 'İhtiyaçlarınıza uygun model, renk ve cam seçeneklerini belirliyoruz.' },
  { icon: 'fas fa-industry', title: '3. Üretim', text: 'Modern makinelerle özel ölçüde kaliteli üretim gerçekleştiriyoruz.' },
  { icon: 'fas fa-wrench', title: '4. Montaj & Teslim', text: 'Profesyonel montaj ile ürünlerinizi güvenle teslim ediyoruz.' },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  keywords={keywords}
  activePage="pvc"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />
  </Fragment>

  <PageHeader active="PVC Kapı ve Pencere Sistemleri" />

  <!-- PVC Services Section Start -->
  <div class="container-fluid py-6 px-3 px-md-5 materials-section">
    <div class="materials-container">
      <SectionHeader
        as="h1"
        accent="PVC Kapı ve Pencere"
        title="Sistemleri"
        lede={`AR-KAR İnşaat olarak ${EXPERIENCE_YEARS} yıllık deneyimimizle Samsun Çarşamba'da en kaliteli PVC kapı ve pencere sistemlerini sunuyoruz. Enerji verimli, güvenli ve estetik PVC doğrama çözümleriyle yaşam alanlarınızı konforlu hale getiriyoruz.`}
      />

      <!-- Service Cards -->
      <div class="row g-4 mb-5">
        {SERVICES.map((service) => (
          <div class="col-xl-4 col-lg-6 col-md-6">
            <Card padded={false} class="h-100 d-flex flex-column">
              <CardMedia src={service.img} alt={service.alt} aspectRatio="4 / 3">
                <Badge slot="badge" label={service.badgeLabel} icon={service.badgeIcon} />
              </CardMedia>
              <div class="card-surface__body flex-grow-1 d-flex flex-column">
                <h3 class="h4 mb-3">{service.title}</h3>
                <p class="text-body-secondary mb-3">{service.description}</p>
                <ul class="list-unstyled mb-0 mt-auto">
                  {service.features.map((f) => (
                    <li class="py-1"><i class="fa fa-check text-primary me-2" aria-hidden="true"></i>{f}</li>
                  ))}
                </ul>
              </div>
            </Card>
          </div>
        ))}
      </div>

      <!-- Process Section -->
      <div class="row mb-5">
        <div class="col-12">
          <div class="bg-primary text-white p-4 p-md-5 rounded-3">
            <h2 class="text-center text-white mb-4">
              PVC Kapı Pencere <span>Montaj Sürecimiz</span>
            </h2>
            <div class="row g-4">
              {PROCESS_STEPS.map((step) => (
                <div class="col-lg-3 col-md-6">
                  <div class="text-center">
                    <div class="mb-3 d-flex justify-content-center">
                      <IconBadge icon={step.icon} size="lg" tone="invert" />
                    </div>
                    <h4 class="text-white h5">{step.title}</h4>
                    <p class="mb-0" style="color: rgba(255,255,255,0.85)">{step.text}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <CtaBand
        title="PVC Kapı Pencere Sistemleri İçin Hemen İletişime Geçin!"
        text={`${EXPERIENCE_YEARS} yıllık deneyimimizle en kaliteli PVC doğrama sistemlerini sizlere sunuyoruz. Ücretsiz keşif ve fiyat teklifi için hemen arayın.`}
        primaryHref="tel:+905421526755"
        primaryLabel="0542 152 67 55"
        primaryIcon="fa-phone"
        secondaryHref="https://wa.me/90542526755"
        secondaryLabel="WhatsApp"
        secondaryIcon="fab fa-whatsapp"
      />
    </div>
  </div>
  <!-- PVC Services Section End -->
</BaseLayout>
