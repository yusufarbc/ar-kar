---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Sık Sorulan Sorular - AR-KAR İnşaat | Samsun Çarşamba";
const description = "AR-KAR İnşaat hakkında sık sorulan sorular ve cevapları. İnşaat, PVC, tarım ve diğer hizmetlerimiz hakkında merak ettikleriniz.";
const canonical = "https://ar-kar.com/sss";
const ogImage = "https://ar-kar.com/img/logo.webp";

---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  
  activePage="sss"
>
  <Fragment slot="head">
    <style is:inline set:html={`/* FAQ specific styles */
        .accordion-item {
            border: none;
            border-radius: 10px !important;
            margin-bottom: 1rem;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        
        .accordion-button {
            font-weight: 600;
            font-size: 1.1rem;
            border-radius: 10px !important;
            background-color: #f8f9fa;
        }
        
        .accordion-button:not(.collapsed) {
            background-color: var(--bs-primary);
            color: white;
        }
        
        .accordion-body {
            font-size: 1rem;
            line-height: 1.6;
            color: #666;
        }
        
        /* Mobile optimizations */
        @media (max-width: 768px) {
            .display-5 {
                font-size: 2rem;
            }
            
            .py-6 {
                padding-top: 3rem !important;
                padding-bottom: 3rem !important;
            }
            
            .accordion-button {
                font-size: 1rem;
            }
        }
        
        /* WhatsApp floating button */
        .whatsapp-float {
            position: fixed;
            width: 60px;
            height: 60px;
            bottom: 20px;
            right: 20px;
            background-color: #25d366;
            color: white;
            border-radius: 50px;
            text-align: center;
            font-size: 30px;
            box-shadow: 2px 2px 3px #999;
            z-index: 1000;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
        }
        
        .whatsapp-float:hover {
            background-color: #20c55e;
            color: white;
            transform: scale(1.1);
            text-decoration: none;
        }
        
        @media (max-width: 768px) {
            .whatsapp-float {
                width: 55px;
                height: 55px;
                bottom: 15px;
                right: 15px;
                font-size: 25px;
            }
        }`} />
  </Fragment>

  <!-- SSS Content -->
    <div class="container-fluid py-6 px-5">
        <div class="text-center mx-auto mb-5" style="max-width: 800px;">
            <h1 class="display-5 text-uppercase mb-4">Sık Sorulan <span class="text-primary">Sorular</span></h1>
            <p class="mb-0">AR-KAR İnşaat hizmetleri hakkında merak ettikleriniz</p>
        </div>
        
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="accordion" id="faqAccordion">
                    
                    <!-- İnşaat Projeleri -->
                    <div class="accordion-item mb-3">
                        <h2 class="accordion-header">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                                İnşaat projeleriniz ne kadare sürede tamamlanıyor?
                            </button>
                        </h2>
                        <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Proje büyüklüğüne göre değişmekle birlikte, ortalama bir konut projesi 8-12 ay içerisinde tamamlanmaktadır. Detaylı zaman planını proje başlangıcında paylaşıyoruz.
                            </div>
                        </div>
                    </div>

                    <!-- PVC Hizmetleri -->
                    <div class="accordion-item mb-3">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                                PVC kapı pencere garantiniz var mı?
                            </button>
                        </h2>
                        <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Evet, tüm PVC kapı pencere sistemlerimizde 10 yıl garanti veriyoruz. Ayrıca montaj sonrası bakım hizmetleri de sunmaktayız.
                            </div>
                        </div>
                    </div>

                    <!-- Ödeme -->
                    <div class="accordion-item mb-3">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                                Ödeme seçenekleriniz nelerdir?
                            </button>
                        </h2>
                        <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Nakit, kredi kartı ve banka kredisi seçenekleri mevcuttur. Büyük projeler için taksitli ödeme planları da sunuyoruz.
                            </div>
                        </div>
                    </div>

                    <!-- Daha fazla soru eklenebilir -->
                    
                </div>
            </div>
        </div>
    </div>
</BaseLayout>
