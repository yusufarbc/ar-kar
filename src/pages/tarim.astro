---
import { EXPERIENCE_YEARS } from '../lib/company';
import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Card from '../components/ui/Card.astro';
import CardMedia from '../components/ui/CardMedia.astro';
import Badge from '../components/ui/Badge.astro';
import IconBadge from '../components/ui/IconBadge.astro';
import CtaBand from '../components/ui/CtaBand.astro';

const title = "Tarım Ürünleri Alım Satımı | AR-KAR İnşaat Samsun | Mısır, Buğday, Fındık Alımı";
const description = "AR-KAR Tarım Ürünleri Alım Satımı: Samsun Çarşamba'da mısır, buğday, fındık alım satımı. Çiftçilerimize adil fiyat, güvenli ödeme, kaliteli hizmet sunuyoruz.";
const canonical = "https://ar-kar.com/tarim";
const ogImage = "https://ar-kar.com/img/tarim.webp";
const keywords = "tarım ürünleri alım satım samsun, mısır alımı çarşamba, buğday alımı samsun, fındık alımı, tarım ürünleri tüccarı, hububat alımı, ürün pazarlama, tarımsal ticaret, çiftçi destekleme";

// Ürün kartları artık Card/CardMedia/Badge bileşenlerinden geliyor; burada
// yalnızca VERİ var (bkz. insaat.astro/pvc.astro'daki aynı desen).
const PRODUCTS = [
  {
    img: '/img/tarim/findik.webp',
    alt: 'Fındık Alım Satımı - AR-KAR',
    badgeIcon: 'fa-seedling',
    badgeLabel: 'Fındık',
    title: 'Fındık Alım Satımı',
    description:
      'Karadeniz bölgesinin en kaliteli fındıklarını alım satımını yapıyoruz. İç ve kabuklu fındık çeşitleri için uygun fiyat teklifi veriyoruz.',
    features: ['Güncel Piyasa Fiyatı', 'Kalite Kontrol', 'Hızlı Ödeme', 'Nakliye Desteği'],
  },
  {
    img: '/img/tarim/misir.webp',
    alt: 'Mısır Alım Satımı - AR-KAR',
    badgeIcon: 'fa-leaf',
    badgeLabel: 'Mısır',
    title: 'Mısır Alım Satımı',
    description:
      'Taze ve kaliteli mısır alım satımı yapıyoruz. Çiftçilerimizden direkt alım, adil fiyat ve hızlı ödeme ile güvenilir ticaret ortağınızız.',
    features: ['Güncel Piyasa Fiyatı', 'Kalite Kontrol', 'Hızlı Ödeme', 'Nakliye Desteği'],
  },
  {
    img: '/img/tarim/bugday.webp',
    alt: 'Buğday Alım Satımı - AR-KAR',
    badgeIcon: 'fa-tractor',
    badgeLabel: 'Buğday',
    title: 'Buğday Alım Satımı',
    description:
      'Kaliteli buğday alım satımı ile çiftçilerimize destek oluyoruz. Protein oranı yüksek buğdaylara özel fiyat avantajı sağlıyoruz.',
    features: ['Güncel Piyasa Fiyatı', 'Kalite Kontrol', 'Hızlı Ödeme', 'Nakliye Desteği'],
  },
];

const FEATURES = [
  {
    icon: 'fa-balance-scale',
    title: 'Adil Fiyatlama',
    text: 'Güncel piyasa fiyatları ile çiftçilerimize adil fiyat teklifi sunuyoruz.',
  },
  {
    icon: 'fa-clock',
    title: 'Hızlı Ödeme',
    text: 'Teslim aldığımız ürünlerin ödemelerini hızlı ve güvenli şekilde yapıyoruz.',
  },
  {
    icon: 'fa-microscope',
    title: 'Kalite Kontrol',
    text: 'Modern analiz yöntemleri ile ürün kalitesini test ediyoruz.',
  },
  {
    icon: 'fa-handshake',
    title: 'Güvenilir Ortaklık',
    text: `${EXPERIENCE_YEARS} yıllık deneyimimizle çiftçilerimize güvenilir ortaklık sunuyoruz.`,
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  keywords={keywords}
  activePage="tarim"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={`{
        "@context": "https://schema.org",
        "@type": "WebPage",
        "name": "Tarım Ürünleri Alım Satımı",
        "description": "AR-KAR Tarım Ürünleri: Samsun Çarşamba'da mısır, buğday, fındık alım satımı. Çiftçilerimize adil fiyat, güvenli ödeme.",
        "url": "https://ar-kar.com/tarim",
        "mainEntity": {
            "@type": "LocalBusiness",
            "@id": "https://ar-kar.com/#organization",
            "name": "AR-KAR GIDA TARIM ÜRÜNLERİ VE TAŞIMACILIK TİCARET LİMİTED ŞİRKETİ",
            "alternateName": "AR-KAR İnşaat",
            "url": "https://ar-kar.com",
            "telephone": ["+90 362 846 03 93", "+90 362 834 18 48"],
            "email": "arkargida@gmail.com",
            "address": {
                "@type": "PostalAddress",
                "addressLocality": "Çarşamba",
                "addressRegion": "Samsun",
                "addressCountry": "TR"
            },
            "geo": {
                "@type": "GeoCoordinates",
                "latitude": 41.1986,
                "longitude": 36.7153
            },
            "openingHours": "Mo-Sa 08:00-20:00",
            "areaServed": {
                "@type": "GeoCircle",
                "geoMidpoint": {
                    "@type": "GeoCoordinates",
                    "latitude": 41.1986,
                    "longitude": 36.7153
                },
                "geoRadius": "100000"
            }
        },
        "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "AR-KAR Tarım Ürünleri Alım Satımı",
            "itemListElement": [
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Product",
                        "name": "Mısır Alım Satımı",
                        "description": "Taze ve kaliteli mısır alım satımı, çiftçiden tüketiciye güvenli ticaret",
                        "category": "Tarım Ürünü",
                        "brand": "AR-KAR"
                    }
                },
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Product",
                        "name": "Buğday Alım Satımı",
                        "description": "Kaliteli buğday alım satımı, adil fiyat ve güvenli ödeme garantisi",
                        "category": "Tarım Ürünü",
                        "brand": "AR-KAR"
                    }
                },
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Product",
                        "name": "Fındık Alım Satımı",
                        "description": "Karadeniz fındığı alım satımı, kalite kontrol ve uygun fiyat",
                        "category": "Tarım Ürünü",
                        "brand": "AR-KAR"
                    }
                }
            ]
        }
    }`} />
  </Fragment>

  <PageHeader active="Tarım Ürünleri Alım Satımı" />

  <!-- Agricultural Services Section Start -->
  <div class="container-fluid py-6 px-3 px-md-5 materials-section">
    <div class="materials-container">
      <SectionHeader
        as="h1"
        accent="Tarım Ürünleri"
        title="Alım Satımı"
        lede={`AR-KAR İnşaat olarak ${EXPERIENCE_YEARS} yıllık deneyimimizle Samsun Çarşamba'da tarım ürünleri alım satımı yapıyoruz. Çiftçilerimize adil fiyat, güvenli ödeme, kaliteli hizmet sunarak tarımsal ticarette güvenilir ortağınızız.`}
      />

      <!-- Product Cards -->
      <div class="row g-4 mb-5">
        {PRODUCTS.map((product) => (
          <div class="col-xl-4 col-lg-6 col-md-6">
            <Card padded={false} class="h-100 d-flex flex-column">
              <CardMedia src={product.img} alt={product.alt}>
                <Badge slot="badge" label={product.badgeLabel} icon={product.badgeIcon} />
              </CardMedia>
              <div class="card-surface__body flex-grow-1 d-flex flex-column">
                <h3 class="h4 mb-3">{product.title}</h3>
                <p class="text-body-secondary mb-3">{product.description}</p>
                <ul class="list-unstyled mb-0 mt-auto">
                  {product.features.map((f) => (
                    <li class="py-1"><i class="fa fa-check text-primary me-2" aria-hidden="true"></i>{f}</li>
                  ))}
                </ul>
              </div>
            </Card>
          </div>
        ))}
      </div>

      <!-- Features Section -->
      <div class="row mb-5">
        <div class="col-12">
          <div class="bg-light p-4 p-md-5 rounded-3">
            <div class="section-header section-header--center mb-4">
              <h2 class="section-title">Neden <span class="text-primary">AR-KAR</span> Tarım Ürünleri?</h2>
            </div>
            <div class="row g-4">
              {FEATURES.map((feature) => (
                <div class="col-lg-3 col-md-6">
                  <div class="text-center">
                    <div class="mb-3 d-flex justify-content-center">
                      <IconBadge icon={feature.icon} size="lg" tone="solid" />
                    </div>
                    <h4>{feature.title}</h4>
                    <p class="text-muted">{feature.text}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <CtaBand
        title="Tarım Ürünlerinizi Değerlendirin!"
        text="Mısır, buğday, fındık ve diğer tarım ürünlerinizi en iyi fiyata satmak için hemen iletişime geçin. Ücretsiz değerlendirme ve fiyat teklifi alın."
        primaryHref="tel:+903628460393"
        primaryLabel="+90 362 846 03 93"
        primaryIcon="fa-phone"
        secondaryHref="https://wa.me/905421526755"
        secondaryLabel="WhatsApp"
        secondaryIcon="fab fa-whatsapp"
      />
    </div>
  </div>
  <!-- Agricultural Services Section End -->
</BaseLayout>
