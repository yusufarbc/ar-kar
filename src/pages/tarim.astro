---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Tarım Ürünleri Alım Satımı | AR-KAR İnşaat Samsun | Mısır, Buğday, Fındık Alımı";
const description = "AR-KAR Tarım Ürünleri Alım Satımı: Samsun Çarşamba'da mısır, buğday, fındık alım satımı. Çiftçilerimize adil fiyat, güvenli ödeme, kaliteli hizmet sunuyoruz.";
const canonical = "https://ar-kar.com/tarim";
const ogImage = "https://ar-kar.com/img/tarim.webp";
const keywords = "tarım ürünleri alım satım samsun, mısır alımı çarşamba, buğday alımı samsun, fındık alımı, tarım ürünleri tüccarı, hububat alımı, ürün pazarlama, tarımsal ticaret, çiftçi destekleme";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  keywords={keywords}
  activePage="tarim"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={`{
        "@context": "https://schema.org",
        "@type": "WebPage",
        "name": "Tarım Ürünleri Alım Satımı",
        "description": "AR-KAR Tarım Ürünleri: Samsun Çarşamba'da mısır, buğday, fındık alım satımı. Çiftçilerimize adil fiyat, güvenli ödeme.",
        "url": "https://ar-kar.com/tarim",
        "mainEntity": {
            "@type": "LocalBusiness",
            "@id": "https://ar-kar.com/#organization",
            "name": "AR-KAR İnşaat Gıda Tarım Ürünleri ve Taş. Tic. Ltd. Şti.",
            "alternateName": "AR-KAR İnşaat",
            "url": "https://ar-kar.com",
            "telephone": ["+90 362 846 03 93", "+90 362 834 18 48"],
            "email": "arkargida@gmail.com",
            "address": {
                "@type": "PostalAddress",
                "addressLocality": "Çarşamba",
                "addressRegion": "Samsun",
                "addressCountry": "TR"
            },
            "geo": {
                "@type": "GeoCoordinates",
                "latitude": 41.1986,
                "longitude": 36.7153
            },
            "openingHours": "Mo-Sa 08:00-18:00",
            "areaServed": {
                "@type": "GeoCircle",
                "geoMidpoint": {
                    "@type": "GeoCoordinates",
                    "latitude": 41.1986,
                    "longitude": 36.7153
                },
                "geoRadius": "100000"
            }
        },
        "breadcrumb": {
            "@type": "BreadcrumbList",
            "itemListElement": [
                {
                    "@type": "ListItem",
                    "position": 1,
                    "name": "Ana Sayfa",
                    "item": "https://ar-kar.com/"
                },
                {
                    "@type": "ListItem",
                    "position": 2,
                    "name": "Tarım Ürünleri Alım Satımı",
                    "item": "https://ar-kar.com/tarim"
                }
            ]
        },
        "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "AR-KAR Tarım Ürünleri Alım Satımı",
            "itemListElement": [
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Product",
                        "name": "Mısır Alım Satımı",
                        "description": "Taze ve kaliteli mısır alım satımı, çiftçiden tüketiciye güvenli ticaret",
                        "category": "Tarım Ürünü",
                        "brand": "AR-KAR"
                    }
                },
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Product",
                        "name": "Buğday Alım Satımı",
                        "description": "Kaliteli buğday alım satımı, adil fiyat ve güvenli ödeme garantisi",
                        "category": "Tarım Ürünü",
                        "brand": "AR-KAR"
                    }
                },
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Product",
                        "name": "Fındık Alım Satımı",
                        "description": "Karadeniz fındığı alım satımı, kalite kontrol ve uygun fiyat",
                        "category": "Tarım Ürünü",
                        "brand": "AR-KAR"
                    }
                }
            ]
        }
    }`} />
    <style is:inline set:html={`/* Critical CSS for above-the-fold content */
        .navbar-brand img {
            transition: transform 0.3s ease;
        }
        
        .navbar-brand img:hover {
            transform: scale(1.05);
        }

        /* Lazy Loading Enhancement */
        img[loading="lazy"] {
            transition: opacity 0.3s ease;
        }

        /* Agriculture product cards */
        .agriculture-card {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            height: 100%;
        }

        .agriculture-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.15);
        }

        .agriculture-card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .agriculture-card:hover img {
            transform: scale(1.1);
        }

        .card-content {
            padding: 1.5rem;
        }

        .product-badge {
            background: var(--bs-primary);
            color: white;
            padding: 0.5rem 1rem;
            border-radius: 25px;
            font-size: 0.85rem;
            font-weight: 600;
            display: inline-block;
            margin-bottom: 1rem;
        }

        /* Process timeline */
        .process-timeline {
            position: relative;
            padding: 2rem 0;
        }

        .timeline-item {
            display: flex;
            align-items: center;
            margin-bottom: 2rem;
            position: relative;
        }

        .timeline-icon {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: var(--bs-primary);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            margin-right: 1.5rem;
            flex-shrink: 0;
        }

        .timeline-content h4 {
            color: var(--bs-primary);
            margin-bottom: 0.5rem;
        }

        /* Accessibility improvements */
        .btn:focus,
        .nav-link:focus,
        .agriculture-card:focus {
            outline: 2px solid var(--bs-primary);
            outline-offset: 2px;
        }

        /* Reduced motion support */
        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
        }

        /* Mobile optimizations */
        @media (max-width: 768px) {
            .timeline-item {
                flex-direction: column;
                text-align: center;
            }
            
            .timeline-icon {
                margin-right: 0;
                margin-bottom: 1rem;
            }
            
            .display-5 {
                font-size: 2rem;
            }
            
            .py-6 {
                padding-top: 3rem !important;
                padding-bottom: 3rem !important;
            }
            
            .footer .navbar-brand img {
                max-height: 60px !important;
                width: auto;
            }
        }
        
        /* WhatsApp floating button */
        .whatsapp-float {
            position: fixed;
            width: 60px;
            height: 60px;
            bottom: 20px;
            right: 20px;
            background-color: #25d366;
            color: white;
            border-radius: 50px;
            text-align: center;
            font-size: 30px;
            box-shadow: 2px 2px 3px #999;
            z-index: 1000;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
        }
        
        .whatsapp-float:hover {
            background-color: #20c55e;
            color: white;
            transform: scale(1.1);
            text-decoration: none;
        }
        
        @media (max-width: 768px) {
            .whatsapp-float {
                width: 55px;
                height: 55px;
                bottom: 15px;
                right: 15px;
                font-size: 25px;
            }
        }`} />
    <style is:inline set:html={`/* Agricultural Product Card Styles */
        .agri-card {
            transition: all 0.3s ease;
            border: none;
            overflow: hidden;
            position: relative;
        }

        .agri-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.1) !important;
        }

        .agri-card .card-img-container {
            overflow: hidden;
            position: relative;
        }

        .agri-card .card-img-top {
            transition: transform 0.3s ease;
            height: 250px;
            object-fit: cover;
        }

        .agri-card:hover .card-img-top {
            transform: scale(1.08);
        }

        .agri-badge {
            background: linear-gradient(135deg, #28a745, #20c997);
            font-weight: 600;
            font-size: 0.9rem;
            border-radius: 0 0 15px 0 !important;
            backdrop-filter: blur(10px);
        }

        .agri-card .card-title {
            color: var(--dark);
            font-weight: 700;
            line-height: 1.2;
            margin-bottom: 15px;
        }

        .agri-card .list-unstyled li {
            padding: 6px 0;
            font-size: 0.9rem;
            transition: all 0.2s ease;
        }

        .agri-card .list-unstyled li:hover {
            padding-left: 10px;
        }

        .agri-card .btn {
            font-weight: 600;
            padding: 12px 20px;
            border-radius: 8px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .agri-card .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(40, 167, 69, 0.3);
        }

        /* Features Section Styles */
        .features-section .bg-success .rounded-circle {
            background: linear-gradient(135deg, #28a745, #20c997) !important;
            transition: all 0.3s ease;
        }

        .features-section .rounded-circle:hover {
            transform: scale(1.1) rotate(5deg);
            box-shadow: 0 10px 20px rgba(40, 167, 69, 0.3);
        }

        /* Process Section Styles */
        .process-section .bg-white {
            transition: all 0.3s ease;
        }

        .process-section .rounded-circle:hover {
            transform: scale(1.1);
            box-shadow: 0 10px 25px rgba(40, 167, 69, 0.2);
        }

        /* Responsive Adjustments */
        @media (max-width: 768px) {
            .agri-card .card-body {
                padding: 20px;
            }
            
            .agri-badge {
                font-size: 0.8rem;
                padding: 8px 12px;
            }

            .display-5 {
                font-size: 2rem;
            }
        }

        @media (min-width: 992px) {
            .agri-card .card-body {
                padding: 30px;
            }
        }

        /* Animation for agricultural cards */
        .agri-card {
            opacity: 0;
            animation: fadeInUp 0.6s ease forwards;
        }

        .agri-card:nth-child(1) { animation-delay: 0.1s; }
        .agri-card:nth-child(2) { animation-delay: 0.2s; }
        .agri-card:nth-child(3) { animation-delay: 0.3s; }
        .agri-card:nth-child(4) { animation-delay: 0.4s; }
        .agri-card:nth-child(5) { animation-delay: 0.5s; }
        .agri-card:nth-child(6) { animation-delay: 0.6s; }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Section background gradients */
        .agri-services-section {
            background: linear-gradient(135deg, #f8fffe 0%, #e8f5e8 100%);
            position: relative;
        }

        .agri-services-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 100px;
            background: linear-gradient(to bottom, rgba(40, 167, 69, 0.05), transparent);
        }

        /* Call to action enhanced styles */
        .cta-agri {
            background: linear-gradient(135deg, #28a745, #20c997);
            position: relative;
            overflow: hidden;
        }

        .cta-agri::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="2" fill="rgba(255,255,255,0.1)"/></svg>') repeat;
            animation: float 20s infinite linear;
        }

        @keyframes float {
            0% { transform: translate(-50%, -50%) rotate(0deg); }
            100% { transform: translate(-50%, -50%) rotate(360deg); }
        }

        /* Price ticker style */
        .price-ticker {
            background: linear-gradient(135deg, #28a745, #20c997);
            color: white;
            padding: 10px 0;
            overflow: hidden;
            position: relative;
        }

        .ticker-content {
            display: inline-block;
            white-space: nowrap;
            animation: scroll 30s linear infinite;
        }

        @keyframes scroll {
            0% { transform: translateX(100%); }
            100% { transform: translateX(-100%); }
        }`} />
  </Fragment>

  <!-- Breadcrumb Start -->
    <div class="container-fluid bg-dark py-3 px-3 px-md-5">
