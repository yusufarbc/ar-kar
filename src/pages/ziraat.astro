---
import { EXPERIENCE_YEARS } from '../lib/company';
import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Card from '../components/ui/Card.astro';
import CardMedia from '../components/ui/CardMedia.astro';
import Badge from '../components/ui/Badge.astro';

const title = "Zirai İlaç Mağazası | AR-KAR İnşaat Samsun | Gübre Tohum Satışı";
const description = "AR-KAR Zirai Ürünler Mağazası: Samsun Çarşamba'da tohum, gübre ve zirai ilaç satışı yapan mağazamızda tarım danışmanlığı hizmeti de vermekteyiz. Çiftçilerimize kaliteli tarımsal girdiler ve uzman destek.";
const canonical = "https://ar-kar.com/ziraat";
const ogImage = "https://ar-kar.com/img/ziraat.webp";
const keywords = "zirai ilaç mağazası samsun, gübre satışı çarşamba, tohum mağazası, tarımsal girdi mağazası, tarım danışmanlığı, bitki koruma ürünleri satışı, tarım ilacı mağazası, organik gübre satışı, hibrit tohum mağazası, tarımsal kimyasal mağazası";

// Mağazada satılan ürün grupları — kart markup'ı (görsel + rozet + başlık +
// açıklama) artık Card/CardMedia/Badge bileşenlerinden geliyor (bkz.
// insaat.astro/tarim.astro'daki aynı desen).
const PRODUCTS = [
  {
    img: '/img/ilac.webp',
    alt: 'Bitki Koruma Ürünleri - AR-KAR Mağazası',
    badgeIcon: 'fa-shield-alt',
    badgeLabel: 'Bitki Koruma',
    title: 'Bitki Koruma Ürünleri',
    description: 'Mağazamızda herbisit, fungisit, insektisit ve diğer bitki koruma ürünleri bulunmaktadır.',
  },
  {
    img: '/img/gubre.webp',
    alt: 'Gübre Çeşitleri - AR-KAR Mağazası',
    badgeIcon: 'fa-leaf',
    badgeLabel: 'Gübre',
    title: 'Gübre Çeşitleri',
    description:
      'Organik, kimyevi ve sıvı gübre çeşitleri mevcuttur. Toprak analizi sonucuna göre uygun gübre önerisi sunuyoruz.',
  },
  {
    img: '/img/tohum.webp',
    alt: 'Tohum Satışı - AR-KAR Mağazası',
    badgeIcon: 'fa-seedling',
    badgeLabel: 'Tohum',
    title: 'Tohum Satışı',
    description: 'Hibrit ve açık tozlanma tohum çeşitleri. Sebze, meyve ve tarla bitkileri için kaliteli tohumlar.',
  },
];

const ADVANTAGES = [
  { title: 'Kaliteli Ürünler', text: 'Tüm tarımsal girdilerimiz sertifikalı ve kalite garantili.' },
  { title: 'Uzman Danışmanlık', text: 'Deneyimli tarım uzmanlarından profesyonel danışmanlık.' },
  { title: 'Uygun Fiyat', text: 'Piyasa koşullarında en uygun fiyat garantisi.' },
  { title: `${EXPERIENCE_YEARS} Yıllık Güven`, text: 'Sektördeki köklü tecrübemizle güvenilir hizmet.' },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  keywords={keywords}
  activePage="ziraat"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={`{
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "AR-KAR İnşaat - Zirai İlaç Mağazası",
        "description": "Samsun Çarşamba'da zirai ilaç, gübre ve tohum satışı yapan mağazamızda tarım danışmanlığı hizmeti de vermekteyiz. Kaliteli tarımsal girdiler ve uzman destek.",
        "url": "https://ar-kar.com/ziraat",
        "email": "arkargida@gmail.com",
        "address": {
            "@type": "PostalAddress",
            "streetAddress": "İnönü Mah. Gazi Cad.",
            "addressLocality": "Çarşamba",
            "addressRegion": "Samsun",
            "postalCode": "55500",
            "addressCountry": "TR"
        },
        "geo": {
            "@type": "GeoCoordinates",
            "latitude": 41.1986,
            "longitude": 36.7153
        },
        "openingHours": "Mo-Sa 08:00-20:00",
        "priceRange": "$$",
        "serviceArea": {
            "@type": "GeoCircle",
            "geoMidpoint": {
                "@type": "GeoCoordinates",
                "latitude": 41.1986,
                "longitude": 36.7153
            },
            "geoRadius": "50000"
        },
        "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "Zirai İlaç Mağaza Hizmetleri",
            "itemListElement": [
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Service",
                        "name": "Bitki Koruma Ürünleri",
                        "description": "Mağazamızda herbisit, fungisit, insektisit gibi zirai ilaçlar satışı"
                    }
                },
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Service",
                        "name": "Gübre Satışı",
                        "description": "Mağazamızda organik, kimyevi, sıvı gübre satışı"
                    }
                },
                {
                    "@type": "Offer",
                    "itemOffered": {
                        "@type": "Service",
                        "name": "Tohum Satışı",
                        "description": "Mağazamızda hibrit tohumlar, sebze tohumları satışı"
                    }
                }
            ]
        }
    }`} />
  </Fragment>

  <PageHeader active="Zirai Ürünler ve Danışmanlık" />

  <div class="container-fluid py-6 px-3 px-md-5 materials-section">
    <div class="materials-container">
      <!-- Service Features Start -->
      <div class="row g-5 align-items-center mb-5">
        <div class="col-lg-8">
          <div class="section-header mb-4">
            <h2 class="section-title">AR-KAR <span class="text-primary">Zirai Ürünler</span> Mağazası Avantajları</h2>
          </div>
          <h4 class="text-primary mb-4">Kaliteli Tarımsal Girdiler ve Profesyonel Danışmanlık</h4>
          <p class="mb-4">AR-KAR Zirai Ürünler Mağazası olarak, {EXPERIENCE_YEARS} yıllık güven ve kalite anlayışımızla çiftçilerimize en kaliteli tarımsal girdileri sunuyoruz. Uzman ekibimizle tarım danışmanlığı hizmeti vererek, verimli ve sürdürülebilir tarım uygulamalarını destekliyoruz.</p>
          <p class="mb-4">Deneyimli tarım uzmanlarımız ile bitki beslenme programları, hastalık-zararlı mücadelesi ve toprak analizi hizmetleri sunarak, çiftçilerimizin başarısını garanti altına alıyoruz. Kaliteli ürün garantisi ve uzman desteği ile yanınızdayız.</p>

          <div class="row g-4">
            {ADVANTAGES.map((advantage) => (
              <div class="col-md-6">
                <div class="d-flex">
                  <i class="fa fa-check-circle fa-2x text-primary flex-shrink-0 me-3" aria-hidden="true"></i>
                  <div>
                    <h5>{advantage.title}</h5>
                    <p class="mb-0">{advantage.text}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="col-lg-4">
          <Card padded={false}>
            <CardMedia src="/img/ziraat.webp" alt="AR-KAR Zirai Ürünler Mağazası" aspectRatio="1 / 1" />
          </Card>
        </div>
      </div>
      <!-- Service Features End -->

      <!-- Services Start -->
      <div class="category-section">
        <SectionHeader accent="Ziraat Mağazamızda" title="Satışını Yaptığımız Ürünler" />
        <div class="row g-4 mb-5">
          {PRODUCTS.map((product) => (
            <div class="col-lg-4 col-md-6">
              <Card padded={false} class="h-100 d-flex flex-column">
                <CardMedia src={product.img} alt={product.alt}>
                  <Badge slot="badge" label={product.badgeLabel} icon={product.badgeIcon} />
                </CardMedia>
                <div class="card-surface__body flex-grow-1 d-flex flex-column">
                  <h3 class="h5 mb-2">{product.title}</h3>
                  <p class="text-body-secondary mb-0">{product.description}</p>
                </div>
              </Card>
            </div>
          ))}
        </div>
      </div>
      <!-- Services End -->

      <!-- CTA Section Start -->
      <div class="cta-band">
        <h3>Kaliteli Zirai Ürün ve Danışmanlık Hizmeti Arıyorsanız</h3>
        <p>AR-KAR Zirai Ürünler Mağazası ile iletişime geçin. Kalite ve güven bizim önceliğimizdir.</p>
        <div class="cta-band__actions">
          <button type="button" class="btn btn-light btn-lg px-4" data-bs-toggle="modal" data-bs-target="#contactModal">
            <i class="fa fa-phone me-2" aria-hidden="true"></i>Hemen Arayın
          </button>
        </div>
      </div>
      <!-- CTA Section End -->
    </div>
  </div>
</BaseLayout>
